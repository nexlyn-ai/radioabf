---
import Base from "../../layouts/Base.astro";
import ABFTVPlayer from "../../components/ABFTVPlayer.astro";

export const prerender = false;
---

<Base
  isABFTV={true}
  title="ABF TV Live | The Visual Frequency"
  description="Watch ABF TV live. The Visual Frequency, part of ABF Network."
>
  <main class="abftv-live-page">
    <div class="abftv-live-container">
      <a class="abftv-back" href="/abftv">← ABF TV Home</a>

      <header class="abftv-live-heading">
        <div>
          <span class="abftv-kicker">THE VISUAL FREQUENCY</span>
          <h1>Watch ABF TV Live</h1>
          <p>Welcome to ABF TV. Enjoy our live channel.</p>
        </div>
        <span class="abftv-live-badge">● LIVE 24/7</span>
      </header>

      <ABFTVPlayer />
    </div>
  </main>

  <style>
    .abftv-live-page {
      min-height: 100vh;
      padding: 32px 20px 80px;
      color: #fff;
      background:
        radial-gradient(circle at 50% 0%, rgba(147, 51, 234, .18), transparent 45%),
        #080611;
    }

    .abftv-live-container {
      width: min(1180px, 100%);
      margin-inline: auto;
    }

    .abftv-back {
      display: inline-block;
      margin-bottom: 32px;
      color: #c4b5fd;
      text-decoration: none;
      font-weight: 700;
    }

    .abftv-back:hover {
      color: #e9d5ff;
    }

    .abftv-live-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .abftv-kicker {
      color: #a78bfa;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .2em;
    }

    h1 {
      margin: 8px 0;
      font-size: clamp(36px, 6vw, 64px);
      line-height: 1.1;
    }

    p {
      color: #c4b5fd;
    }

    .abftv-live-badge {
      padding: 10px 16px;
      border-radius: 30px;
      background: #7e22ce;
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
    }

    @media (max-width: 700px) {
      .abftv-live-heading {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</Base>