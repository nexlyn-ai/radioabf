---
import Base from "../../layouts/Base.astro";
import ABFTVPlayer from "../../components/ABFTVPlayer.astro";

export const prerender = false;

const streamUrl =
  "https://stream.radioabf.com/hls-tv/abf-tv.m3u8";
---

<Base isABFTV={true}
  title="ABF TV | ABF Network"
  description="ABF TV — The Visual Frequency. Watch our live television channel, movies, animation and original programming."
>
  <main class="abftv-page">

    <!-- ABF TV / NETWORK TOP CARD -->
    <section class="abftv-topbar" aria-label="ABF Network navigation">
      <div class="abftv-topbar-brand">
        <img src="/logo-abftv.png" alt="ABF TV" />
        <div>
          <strong>ABF TV</strong>
          <span>The Visual Frequency</span>
        </div>
      </div>

      <div class="abftv-topbar-actions">
        <a href="#abftvVideo" class="abftv-watch-btn">
          <span aria-hidden="true">●</span>
          Watch Live
        </a>

        <a href="/" class="abftv-switch abftv-switch-radio">
          <span class="abftv-switch-dot" aria-hidden="true"></span>
          <span>
            <strong>Radio ABF</strong>
            <small>The DJs' Frequency</small>
          </span>
        </a>

        <a href="/abf2" class="abftv-switch abftv-switch-abf2">
          <span class="abftv-switch-dot" aria-hidden="true"></span>
          <span>
            <strong>ABF 2</strong>
            <small>The Hits Frequency</small>
          </span>
        </a>
      </div>
    </section>

    <section class="abftv-live">
      <div class="abftv-heading">
        <div>
          <span class="abftv-kicker">ABF NETWORK PRESENTS</span>
          <h1>ABF TV</h1>
          <p>The Visual Frequency</p>
        </div>

        <span class="abftv-badge">● LIVE 24/7</span>
      </div>

      <ABFTVPlayer />
    </section>

    <!-- ABFTV HOME EDITORIAL 2026 -->

    <section class="abftv-editorial" aria-labelledby="abftv-discover-title">
      <div class="abftv-section-head">
        <span class="abftv-section-kicker">THE VISUAL FREQUENCY</span>
        <h2 id="abftv-discover-title">Discover ABF TV</h2>
        <p>
          A visual universe built around cinema, animation, documentaries
          and digital creativity. Explore the stories, images and ideas
          behind our independent television channel.
        </p>
      </div>

      <div class="abftv-editorial-grid">
        <article class="abftv-editorial-card">
          <span class="abftv-card-number">01 / CINEMA</span>
          <h3>Cinema &amp; Movies</h3>
          <p>
            From science fiction to short films and independent cinema,
            discover stories made for the screen.
          </p>
        </article>

        <article class="abftv-editorial-card">
          <span class="abftv-card-number">02 / ANIMATION</span>
          <h3>Anime &amp; Animation</h3>
          <p>
            Animated worlds, distinctive visual styles and imaginative
            storytelling from different creative traditions.
          </p>
        </article>

        <article class="abftv-editorial-card">
          <span class="abftv-card-number">03 / DISCOVERY</span>
          <h3>Documentaries</h3>
          <p>
            Images that inform and inspire, exploring culture,
            science, technology and the world around us.
          </p>
        </article>

        <article class="abftv-editorial-card">
          <span class="abftv-card-number">04 / CREATION</span>
          <h3>Digital Creativity</h3>
          <p>
            Independent audiovisual creations, experimental imagery
            and new ways of telling stories through moving pictures.
          </p>
        </article>
      </div>
    </section>

    <!-- ABF NETWORK -->
    <section class="abftv-network" aria-labelledby="abftv-network-title">
      <div class="abftv-section-head">
        <span class="abftv-section-kicker">ABF NETWORK</span>
        <h2 id="abftv-network-title">Three media. One network.</h2>
        <p>
          Three complementary identities, connected by one independent
          media project.
        </p>
      </div>

      <div class="abftv-network-grid">
        <article class="abftv-network-card abftv-network-radio">
          <img src="/logo-abf.png" alt="Radio ABF logo" loading="lazy" />
          <h3>Radio ABF</h3>
          <strong>The DJs' Frequency</strong>
          <p>Dance, House, electronic music and DJ culture.</p>
          <a href="/">Discover Radio ABF →</a>
        </article>

        <article class="abftv-network-card abftv-network-abf2">
          <img src="/logo-abf2.png" alt="ABF 2 logo" loading="lazy" />
          <h3>ABF 2</h3>
          <strong>The Hits Frequency</strong>
          <p>Pop, rock, alternative music, classics and today's hits.</p>
          <a href="/abf2">Explore ABF 2 →</a>
        </article>

        <article class="abftv-network-card abftv-network-tv">
          <img src="/logo-abftv.png" alt="ABF TV logo" loading="lazy" />
          <h3>ABF TV</h3>
          <strong>The Visual Frequency</strong>
          <p>Cinema, anime, documentaries and audiovisual discovery.</p>
          <a href="/abftv/about">Discover ABF TV →</a>
        </article>
      </div>
    </section>

    <!-- FINAL SIGNATURE: NO LINKS OR BUTTONS -->
    <section class="abftv-signature" aria-label="ABF TV signature">
      <div class="abftv-signature-card">
        <img src="/logo-abftv.png" alt="ABF TV" loading="lazy" />
        <div class="abftv-signature-copy">
          <span>Alternative Bass Fréquence</span>
          <strong>The Visual Frequency</strong>
        </div>
      </div>
    </section>

  </main>

  <style>
    .abftv-page {
      min-height: 100vh;
      padding: 30px 20px 80px;
      color: white;
      background:
        radial-gradient(
          circle at 50% 0%,
          rgba(147, 51, 234, .18),
          transparent 45%
        ),
        #080611;
    }

    .abftv-topbar,
    .abftv-live,
    .abftv-programs {
      width: min(1180px, 100%);
      margin-inline: auto;
    }

    /* Grande card ABF TV — inspirée d'ABF 2 */
    .abftv-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 22px;
      margin-bottom: 32px;
      padding: 20px 24px;
      border: 1px solid rgba(192, 132, 252, .32);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(88, 28, 135, .35), rgba(20, 10, 36, .95));
      box-shadow: 0 12px 40px rgba(0, 0, 0, .2);
    }

    .abftv-topbar-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .abftv-topbar-brand img {
      width: 68px;
      height: 68px;
      object-fit: contain;
      flex: none;
    }

    .abftv-topbar-brand strong,
    .abftv-topbar-brand span {
      display: block;
    }

    .abftv-topbar-brand strong {
      font-size: 21px;
      font-weight: 900;
      letter-spacing: .04em;
    }

    .abftv-topbar-brand span {
      color: #c4b5fd;
      font-size: 12px;
    }

    .abftv-topbar-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 10px;
    }

    .abftv-watch-btn,
    .abftv-switch {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 10px 15px;
      border-radius: 13px;
      text-decoration: none;
      transition: background .2s, border-color .2s, transform .2s;
    }

    .abftv-watch-btn:hover,
    .abftv-switch:hover {
      transform: translateY(-2px);
    }

    .abftv-watch-btn {
      color: white;
      background: #7e22ce;
      border: 1px solid #a855f7;
      font-size: 13px;
      font-weight: 900;
    }

    .abftv-watch-btn:hover {
      background: #9333ea;
    }

    .abftv-switch {
      border: 1px solid rgba(255, 255, 255, .14);
      background: rgba(255, 255, 255, .035);
      color: white;
    }

    .abftv-switch strong,
    .abftv-switch small {
      display: block;
      white-space: nowrap;
    }

    .abftv-switch strong {
      font-size: 12px;
      font-weight: 800;
    }

    .abftv-switch small {
      color: #aaa0b8;
      font-size: 10px;
    }

    .abftv-switch-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex: none;
    }

    /* Radio ABF : cyan */
    .abftv-switch-radio .abftv-switch-dot {
      background: #22d3ee;
      box-shadow: 0 0 10px rgba(34, 211, 238, .6);
    }

    .abftv-switch-radio:hover {
      border-color: #22d3ee;
      background: rgba(34, 211, 238, .1);
    }

    .abftv-switch-radio:hover strong {
      color: #67e8f9;
    }

    /* ABF 2 : rouge */
    .abftv-switch-abf2 .abftv-switch-dot {
      background: #ef4444;
      box-shadow: 0 0 10px rgba(239, 68, 68, .6);
    }

    .abftv-switch-abf2:hover {
      border-color: #ef4444;
      background: rgba(239, 68, 68, .1);
    }

    .abftv-switch-abf2:hover strong {
      color: #fca5a5;
    }
    .abftv-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .abftv-kicker {
      color: #a78bfa;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .2em;
    }

    .abftv-heading h1 {
      margin: 8px 0;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1;
    }

    .abftv-heading p {
      color: #c4b5fd;
    }

    .abftv-badge {
      padding: 10px 16px;
      border-radius: 30px;
      background: #7e22ce;
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
    }

    /* ABFTV HOME EDITORIAL 2026 */

    .abftv-editorial,
    .abftv-network,
    .abftv-signature {
      width: min(1180px, 100%);
      margin-inline: auto;
    }

    .abftv-editorial {
      margin-top: 56px;
    }

    .abftv-section-head {
      margin-bottom: 28px;
    }

    .abftv-section-kicker {
      color: #c084fc;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .19em;
    }

    .abftv-section-head h2 {
      margin: 12px 0 14px;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.1;
      letter-spacing: -.025em;
    }

    .abftv-section-head p {
      max-width: 740px;
      margin: 0;
      color: #bfb4d0;
      line-height: 1.75;
    }

    .abftv-editorial-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .abftv-editorial-card {
      min-width: 0;
      min-height: 220px;
      padding: clamp(24px, 3vw, 34px);
      border: 1px solid rgba(192, 132, 252, .25);
      border-radius: 24px;
      background:
        linear-gradient(135deg, rgba(147, 51, 234, .12), transparent 65%),
        #140e20;
      box-shadow: 0 16px 45px rgba(0, 0, 0, .20);
    }

    .abftv-card-number {
      color: #c084fc;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .15em;
    }

    .abftv-editorial-card h3 {
      margin: 22px 0 12px;
      font-size: clamp(22px, 3vw, 29px);
      letter-spacing: -.02em;
    }

    .abftv-editorial-card p {
      max-width: 440px;
      margin: 0;
      color: #bfb4d0;
      line-height: 1.75;
    }

    .abftv-network {
      margin-top: 56px;
      padding: clamp(25px, 4vw, 44px);
      border: 1px solid rgba(192, 132, 252, .30);
      border-radius: 30px;
      background:
        radial-gradient(circle at 100% 0%, rgba(147, 51, 234, .16), transparent 48%),
        linear-gradient(135deg, #170d27, #0e0918);
      box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
    }

    .abftv-network-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .abftv-network-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 0;
      padding: 25px;
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 22px;
      background: rgba(255, 255, 255, .035);
    }

    .abftv-network-card img {
      width: 78px;
      height: 78px;
      object-fit: contain;
    }

    .abftv-network-card h3 {
      margin: 20px 0 5px;
      font-size: 24px;
    }

    .abftv-network-card strong {
      font-size: 13px;
    }

    .abftv-network-card p {
      flex: 1;
      color: #bfb4d0;
      line-height: 1.7;
    }

    .abftv-network-card a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      margin-top: 15px;
      padding: 0 16px;
      border-radius: 14px;
      color: #fff;
      font-size: 12px;
      font-weight: 900;
      text-align: center;
      text-decoration: none;
      transition: transform .2s ease, filter .2s ease;
    }

    .abftv-network-card a:hover {
      transform: translateY(-2px);
      filter: brightness(1.15);
    }

    .abftv-network-radio {
      border-color: rgba(47, 194, 255, .30);
    }

    .abftv-network-radio strong {
      color: #67e8f9;
    }

    .abftv-network-radio a {
      background: linear-gradient(135deg, #159bd0, #0877aa);
      border: 1px solid rgba(47, 194, 255, .65);
    }

    .abftv-network-abf2 {
      border-color: rgba(255, 49, 80, .30);
    }

    .abftv-network-abf2 strong {
      color: #ff7188;
    }

    .abftv-network-abf2 a {
      background: linear-gradient(135deg, #ff3150, #d8193d);
      border: 1px solid rgba(255, 113, 136, .65);
    }

    .abftv-network-tv {
      border-color: rgba(192, 132, 252, .45);
    }

    .abftv-network-tv strong {
      color: #d8b4fe;
    }

    .abftv-network-tv a {
      background: linear-gradient(135deg, #9333ea, #6b21a8);
      border: 1px solid rgba(192, 132, 252, .65);
    }

    .abftv-signature {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-top: 56px;
      padding: clamp(35px, 6vw, 65px) 24px;
      border: 1px solid rgba(192, 132, 252, .30);
      border-radius: 30px;
      background:
        radial-gradient(circle at 50% 15%, rgba(147, 51, 234, .22), transparent 65%),
        #110a1e;
      box-shadow: 0 24px 70px rgba(0, 0, 0, .30);
      text-align: center;
    }

    .abftv-signature img {
      width: min(150px, 45vw);
      height: auto;
      object-fit: contain;
      margin-bottom: 20px;
    }

    .abftv-signature span {
      font-size: 14px;
      font-weight: 900;
      letter-spacing: .20em;
    }

    .abftv-signature strong {
      margin-top: 12px;
      color: #d8b4fe;
      font-size: clamp(30px, 5vw, 54px);
      line-height: 1.1;
      letter-spacing: -.035em;
    }

    .abftv-signature p {
      margin: 18px 0 0;
      color: #a99bbd;
      font-size: 12px;
      letter-spacing: .07em;
    }

    @media (max-width: 800px) {
      .abftv-network-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .abftv-editorial-grid {
        grid-template-columns: 1fr;
      }

      .abftv-network-card a {
        width: 100%;
      }
    }
    @media (max-width: 700px) {
      .abftv-topbar,
      .abftv-heading {
        flex-direction: column;
        align-items: flex-start;
      }

      .abftv-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ABFTV HOME CARDS REFINEMENT */

    /* Grande carte englobant Discover ABF TV et les quatre univers */
    .abftv-page .abftv-editorial {
      position: relative;
      overflow: hidden;
      margin-top: 56px;
      padding: clamp(25px, 4vw, 44px);
      border: 1px solid rgba(192, 132, 252, .30);
      border-radius: 30px;
      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(147, 51, 234, .16),
          transparent 48%
        ),
        linear-gradient(135deg, #170d27, #0e0918);
      box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
    }

    .abftv-page .abftv-editorial .abftv-section-head {
      margin-bottom: 30px;
    }

    /* Signature horizontale inspirée des homes Radio ABF et ABF 2 */
    .abftv-page .abftv-signature {
      display: block;
      margin-top: 30px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      text-align: left;
    }

    .abftv-page .abftv-signature-card {
      min-height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 22px;
      padding: 25px;
      border-radius: 24px;
      border: 1px solid rgba(192, 132, 252, .16);
      background:
        radial-gradient(
          circle at 50% 0%,
          rgba(147, 51, 234, .10),
          transparent 58%
        ),
        rgba(255, 255, 255, .015);
    }

    .abftv-page .abftv-signature-card img {
      width: 76px;
      height: auto;
      flex: none;
      margin: 0;
      filter: drop-shadow(0 0 14px rgba(147, 51, 234, .25));
    }

    .abftv-page .abftv-signature-copy {
      min-width: 0;
    }

    .abftv-page .abftv-signature-copy span,
    .abftv-page .abftv-signature-copy strong {
      display: block;
    }

    .abftv-page .abftv-signature-copy span {
      color: rgba(255, 255, 255, .38);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .abftv-page .abftv-signature-copy strong {
      margin-top: 4px;
      color: #fff;
      font-size: clamp(1.45rem, 3vw, 2.4rem);
      line-height: 1.15;
      letter-spacing: -.04em;
    }

    @media (max-width: 500px) {
      .abftv-page .abftv-signature-card {
        gap: 15px;
        padding: 20px 15px;
      }

      .abftv-page .abftv-signature-card img {
        width: 60px;
      }
    }
  </style>
</Base>