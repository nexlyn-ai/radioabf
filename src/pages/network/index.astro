---
import Network from "../../layouts/Network.astro";
---

<Network
  title="ABF Network — The network behind the media"
  description="ABF Network is the structure that develops, coordinates and supports Radio ABF, ABF 2 and ABF TV: technology, projects, content and partnerships."
>
  <!-- ================= HERO ================= -->
  <section class="network-hero">
    <div class="network-container">
      <p class="network-eyebrow">ABF NETWORK · INDEPENDENT MEDIA</p>

      <h1>
        The network<br />
        <span>behind the media.</span>
      </h1>

      <p class="network-intro">
        ABF Network develops and supports several media with complementary identities.
        Radio, music, audiovisual, technology and new
        projects are brought together within a single independent structure.
      </p>

      <div class="network-actions">
        <a class="network-button primary" href="/network/about">
          Discover the network <span aria-hidden="true">↗</span>
        </a>

        <a class="network-button secondary" href="/network/technology">
          Our technology <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="network-hero-note">
        <span class="network-hero-line"></span>
        <span>Radio ABF · ABF 2 · ABF TV</span>
      </div>
    </div>
  </section>

  <!-- ================= MEDIA ================= -->
  <section class="network-section" aria-labelledby="media-title">
    <div class="network-container">

      <div class="network-section-heading">
        <p class="network-eyebrow">THE MEDIA NETWORK</p>
        <h2 id="media-title">Three media. Three identities.</h2>
        <p>
          Each medium has its own editorial universe, audience and
          identity. ABF Network provides them with a common structure.
        </p>
      </div>

      <div class="network-media-grid">

        <article class="network-media-card radio">
          <div class="network-media-top">
            <img src="/logo-abf.png" alt="Logo Radio ABF" loading="lazy" />
            <span class="network-media-number">01</span>
          </div>

          <p class="network-media-type">RADIO · ELECTRONIC MUSIC</p>

          <h3>Radio ABF</h3>

          <p class="network-media-claim">The DJs' Frequency</p>

          <p>
            A radio dedicated to electronic music, DJ culture,
            mixes and new expressions of the electronic scene.
          </p>

          <a href="/">
            Discover Radio ABF <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="network-media-card abf2">
          <div class="network-media-top">
            <img src="/logo-abf2.png" alt="Logo ABF 2" loading="lazy" />
            <span class="network-media-number">02</span>
          </div>

          <p class="network-media-type">RADIO · ADULT CONTEMPORARY</p>

          <h3>ABF 2</h3>

          <p class="network-media-claim">The Hits Frequency</p>

          <p>
            A pop, rock and alternative format spanning the
            decades, from major classics to current releases.
          </p>

          <a href="/abf2">
            Discover ABF 2 <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="network-media-card tv">
          <div class="network-media-top">
            <img src="/logo-abftv.png" alt="Logo ABF TV" loading="lazy" />
            <span class="network-media-number">03</span>
          </div>

          <p class="network-media-type">AUDIOVISUAL · VISUAL CULTURE</p>

          <h3>ABF TV</h3>

          <p class="network-media-claim">The Visual Frequency</p>

          <p>
            An audiovisual project dedicated to cinema, animation,
            documentaries and new forms of digital creation.
          </p>

          <a href="/abftv">
            Discover ABF TV <span aria-hidden="true">↗</span>
          </a>
        </article>

      </div>
    </div>
  </section>

  <!-- ================= NETWORK ROLE ================= -->
  <section class="network-section network-role" aria-labelledby="role-title">
    <div class="network-container network-role-grid">

      <div class="network-role-intro">
        <p class="network-eyebrow">THE NETWORK</p>

        <h2 id="role-title">
          ABF Network is not a fourth medium.
        </h2>

        <p class="network-lead">
          It is the structure that allows the network's media to share
          infrastructure, expertise, tools and a common vision
          while retaining their own identities.
        </p>
      </div>

      <div class="network-role-list">

        <div class="network-role-item">
          <span>01</span>
          <div>
            <h3>Develop</h3>
            <p>
              Create new media, new services and new
              experiences around the ABF ecosystem.
            </p>
          </div>
        </div>

        <div class="network-role-item">
          <span>02</span>
          <div>
            <h3>Build</h3>
            <p>
              Develop and maintain the technical infrastructure that enables
              the different projects to work together.
            </p>
          </div>
        </div>

        <div class="network-role-item">
          <span>03</span>
          <div>
            <h3>Connect</h3>
            <p>
              Create connections between media, creators,
              partners and future projects.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= TECHNOLOGY ================= -->
  <section class="network-section" aria-labelledby="technology-title">
    <div class="network-container">

      <div class="network-section-heading">
        <p class="network-eyebrow">TECHNOLOGY</p>
        <h2 id="technology-title">Technology is part of the network.</h2>
        <p>
          ABF Network directly develops part of its technical environment
          in order to retain control of its tools and
          infrastructure.
        </p>
      </div>

      <div class="network-tech-grid">

        <article class="network-tech-card">
          <span class="network-card-index">01</span>
          <h3>Web & interfaces</h3>
          <p>
            Interfaces designed around the needs of listeners,
            viewers and visitors, with a common architecture
            adapted to each medium.
          </p>
        </article>

        <article class="network-tech-card">
          <span class="network-card-index">02</span>
          <h3>Streaming & diffusion</h3>
          <p>
            Infrastructure dedicated to audio distribution and future
            audiovisual uses across the network.
          </p>
        </article>

        <article class="network-tech-card">
          <span class="network-card-index">03</span>
          <h3>Automation & Tools</h3>
          <p>
            Internal tools, automations and workflows
            designed to simplify the daily operation of the media.
          </p>
        </article>

        <article class="network-tech-card">
          <span class="network-card-index">04</span>
          <h3>Continuous Evolution</h3>
          <p>
            The infrastructure evolves with the network projects, allowing
            new services and media to be integrated progressively.
          </p>
        </article>

      </div>

      <div class="network-section-cta">
        <a class="network-text-link" href="/network/technology">
          Explore our infrastructure <span aria-hidden="true">↗</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ================= PROJECTS ================= -->
  <section class="network-section network-projects" aria-labelledby="projects-title">
    <div class="network-container network-projects-grid">

      <div>
        <p class="network-eyebrow">PROJECTS & DEVELOPMENT</p>

        <h2 id="projects-title">
          The network is designed to evolve.
        </h2>

        <p>
          ABF Network is not limited to its current media. The structure
          makes it possible to imagine, test and develop new formats,
          new platforms and new experiences.
        </p>

        <p>
          Some projects are already in development, while others remain
          deliberately open so they can evolve with
          opportunities and collaborations.
        </p>
      </div>

      <div class="network-project-panel">

        <div class="network-project-row">
          <span class="network-project-dot"></span>
          <div>
            <strong>MEDIA</strong>
            <small>New stations and new formats</small>
          </div>
        </div>

        <div class="network-project-row">
          <span class="network-project-dot"></span>
          <div>
            <strong>DIGITAL</strong>
            <small>Services, interfaces and digital experiences</small>
          </div>
        </div>

        <div class="network-project-row">
          <span class="network-project-dot"></span>
          <div>
            <strong>AUDIOVISUAL</strong>
            <small>Development of the network’s visual projects</small>
          </div>
        </div>

        <div class="network-project-row">
          <span class="network-project-dot"></span>
          <div>
            <strong>INNOVATION</strong>
            <small>Automation, AI and new workflows</small>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ================= PROFESSIONAL ================= -->
  <section class="network-section" aria-labelledby="professional-title">
    <div class="network-container">

      <div class="network-section-heading">
        <p class="network-eyebrow">PROFESSIONAL RELATIONS</p>
        <h2 id="professional-title">Open to collaboration.</h2>
        <p>
          ABF Network is also a point of contact for
          collaborations, partnerships and professional relations
          around its media and projects.
        </p>
      </div>

      <div class="network-professional-grid">

        <a class="network-professional-card" href="/network/press">
          <span class="network-professional-index">01</span>
          <div>
            <h3>Press</h3>
            <p>
              Official information, resources and presentation
              of the network for media and journalists.
            </p>
          </div>
          <span class="network-professional-arrow">↗</span>
        </a>

        <a class="network-professional-card" href="/network/partnerships">
          <span class="network-professional-index">02</span>
          <div>
            <h3>Partnerships</h3>
            <p>
              Collaborations, professional projects and opportunities
              with organizations wishing to join the ecosystem.
            </p>
          </div>
          <span class="network-professional-arrow">↗</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="network-final">
    <div class="network-container">

      <p class="network-eyebrow">ABF NETWORK</p>

      <h2>
        Three media today.<br />
        A network built for tomorrow.
      </h2>

      <p>
        Discover the organization, technology and projects
        that make up ABF Network.
      </p>

      <div class="network-actions">
        <a class="network-button primary" href="/network/about">
          About the network <span aria-hidden="true">↗</span>
        </a>

        <a class="network-button secondary" href="/network/partnerships">
          Contact us <span aria-hidden="true">↗</span>
        </a>
      </div>

    </div>
  </section>
</Network>

<style>
  /* =========================================================
     HERO
     ========================================================= */

  .network-hero {
    padding: 112px 0 96px;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(203,213,225,.13), transparent 45%),
      radial-gradient(ellipse at 15% 80%, rgba(100,116,139,.08), transparent 40%),
      linear-gradient(145deg, #17191e, #090a0c 72%);
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .network-eyebrow {
    margin: 0 0 20px;
    color: #aeb4c0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .network-hero h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(48px, 7.5vw, 104px);
    font-weight: 850;
    line-height: 1.02;
    letter-spacing: -.065em;
  }

  .network-hero h1 span {
    color: #aeb4c0;
  }

  .network-intro {
    max-width: 720px;
    margin: 34px 0 0;
    color: rgba(255,255,255,.68);
    font-size: 18px;
    line-height: 1.7;
  }

  .network-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .network-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.14);
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: .18s ease;
  }

  .network-button.primary {
    color: #080a0d;
    background: linear-gradient(135deg, #94a3b8, #e2e8f0);
    border-color: rgba(226,232,240,.4);
    box-shadow: 0 10px 30px rgba(148,163,184,.15);
  }

  .network-button.primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .network-button.secondary {
    color: #e2e8f0;
    background: rgba(255,255,255,.04);
  }

  .network-button.secondary:hover {
    border-color: rgba(203,213,225,.38);
    background: rgba(255,255,255,.08);
  }

  .network-hero-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 54px;
    color: rgba(255,255,255,.38);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .network-hero-line {
    width: 44px;
    height: 1px;
    background: rgba(203,213,225,.45);
  }

  /* =========================================================
     GENERIC SECTIONS
     ========================================================= */

  .network-section {
    padding: 104px 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .network-section-heading {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .network-section-heading h2,
  .network-role h2,
  .network-projects h2 {
    margin: 0;
    color: #f1f5f9;
    font-size: clamp(34px, 4.5vw, 60px);
    font-weight: 820;
    line-height: 1.05;
    letter-spacing: -.045em;
  }

  .network-section-heading > p:last-child,
  .network-role p,
  .network-projects p {
    margin: 20px 0 0;
    color: rgba(255,255,255,.60);
    font-size: 16px;
    line-height: 1.7;
  }

  /* =========================================================
     MEDIA
     ========================================================= */

  .network-media-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .network-media-card {
    min-height: 430px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 22px;
    background: rgba(255,255,255,.035);
    box-shadow: 0 24px 70px rgba(0,0,0,.18);
    transition: transform .18s ease, border-color .18s ease;
  }

  .network-media-card:hover {
    transform: translateY(-3px);
  }

  .network-media-card.radio:hover {
    border-color: rgba(47,194,255,.42);
  }

  .network-media-card.abf2:hover {
    border-color: rgba(239,68,68,.42);
  }

  .network-media-card.tv:hover {
    border-color: rgba(168,85,247,.42);
  }

  .network-media-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    min-height: 78px;
  }

  .network-media-card img {
    width: 68px;
    height: 68px;
    object-fit: contain;
  }

  .network-media-number {
    color: rgba(255,255,255,.25);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .15em;
  }

  .network-media-type {
    margin: 28px 0 10px;
    color: rgba(255,255,255,.42);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .network-media-card h3 {
    margin: 0;
    color: #f8fafc;
    font-size: 30px;
    font-weight: 820;
    letter-spacing: -.035em;
  }

  .network-media-claim {
    margin: 7px 0 0;
    font-size: 12px !important;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .network-media-card.radio .network-media-claim {
    color: #2fc2ff;
  }

  .network-media-card.abf2 .network-media-claim {
    color: #ef4444;
  }

  .network-media-card.tv .network-media-claim {
    color: #a855f7;
  }

  .network-media-card > p:not(.network-media-type):not(.network-media-claim) {
    margin: 20px 0 0;
    color: rgba(255,255,255,.58);
    font-size: 14px;
    line-height: 1.65;
  }

  .network-media-card > a {
    margin-top: auto;
    padding-top: 28px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  .network-media-card.radio > a:hover {
    color: #2fc2ff;
  }

  .network-media-card.abf2 > a:hover {
    color: #ef4444;
  }

  .network-media-card.tv > a:hover {
    color: #a855f7;
  }

  /* =========================================================
     NETWORK ROLE
     ========================================================= */

  .network-role {
    background:
      radial-gradient(ellipse at 75% 45%, rgba(148,163,184,.07), transparent 42%),
      #0a0b0d;
  }

  .network-role-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .85fr);
    gap: 80px;
    align-items: start;
  }

  .network-lead {
    max-width: 650px;
    font-size: 18px !important;
  }

  .network-role-list {
    border-top: 1px solid rgba(255,255,255,.10);
  }

  .network-role-item {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(255,255,255,.10);
  }

  .network-role-item > span {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .network-role-item h3 {
    margin: 0;
    color: #e2e8f0;
    font-size: 18px;
    font-weight: 800;
  }

  .network-role-item p {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.55;
  }

  /* =========================================================
     TECHNOLOGY
     ========================================================= */

  .network-tech-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .network-tech-card {
    min-height: 250px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 18px;
    background: rgba(255,255,255,.025);
  }

  .network-card-index {
    display: block;
    margin-bottom: 55px;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .15em;
  }

  .network-tech-card h3 {
    margin: 0;
    color: #e2e8f0;
    font-size: 18px;
    font-weight: 800;
  }

  .network-tech-card p {
    margin: 10px 0 0;
    color: rgba(255,255,255,.54);
    font-size: 13px;
    line-height: 1.6;
  }

  .network-section-cta {
    margin-top: 28px;
  }

  .network-text-link {
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .network-text-link:hover {
    color: #f1f5f9;
  }

  /* =========================================================
     PROJECTS
     ========================================================= */

  .network-projects {
    background:
      radial-gradient(ellipse at 15% 50%, rgba(148,163,184,.06), transparent 42%),
      #0b0c0f;
  }

  .network-projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .8fr);
    gap: 80px;
    align-items: center;
  }

  .network-project-panel {
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 20px;
    overflow: hidden;
    background: rgba(255,255,255,.025);
  }

  .network-project-row {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px 22px;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .network-project-row:last-child {
    border-bottom: 0;
  }

  .network-project-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #94a3b8;
    box-shadow: 0 0 14px rgba(148,163,184,.45);
  }

  .network-project-row strong {
    display: block;
    color: #e2e8f0;
    font-size: 11px;
    letter-spacing: .12em;
  }

  .network-project-row small {
    display: block;
    margin-top: 4px;
    color: rgba(255,255,255,.45);
    font-size: 12px;
  }

  /* =========================================================
     PROFESSIONAL
     ========================================================= */

  .network-professional-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .network-professional-card {
    position: relative;
    display: grid;
    grid-template-columns: 42px 1fr 20px;
    gap: 18px;
    min-height: 190px;
    padding: 28px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 20px;
    background: rgba(255,255,255,.03);
    color: inherit;
    text-decoration: none;
    transition: .18s ease;
  }

  .network-professional-card:hover {
    transform: translateY(-2px);
    border-color: rgba(203,213,225,.30);
    background: rgba(255,255,255,.05);
  }

  .network-professional-index {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .network-professional-card h3 {
    margin: 0;
    color: #e2e8f0;
    font-size: 24px;
    font-weight: 800;
  }

  .network-professional-card p {
    margin: 10px 0 0;
    color: rgba(255,255,255,.54);
    font-size: 13px;
    line-height: 1.6;
  }

  .network-professional-arrow {
    color: #94a3b8;
    font-size: 16px;
  }

  /* =========================================================
     FINAL CTA
     ========================================================= */

  .network-final {
    padding: 110px 0 120px;
    text-align: center;
    background:
      radial-gradient(ellipse at center, rgba(148,163,184,.11), transparent 58%),
      #090a0c;
  }

  .network-final .network-eyebrow {
    margin-bottom: 18px;
  }

  .network-final h2 {
    margin: 0;
    color: #f1f5f9;
    font-size: clamp(38px, 5.5vw, 72px);
    font-weight: 840;
    line-height: 1.04;
    letter-spacing: -.055em;
  }

  .network-final p:not(.network-eyebrow) {
    max-width: 620px;
    margin: 24px auto 0;
    color: rgba(255,255,255,.56);
    line-height: 1.65;
  }

  .network-final .network-actions {
    justify-content: center;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 1000px) {
    .network-media-grid {
      grid-template-columns: 1fr;
    }

    .network-media-card {
      min-height: 0;
    }

    .network-tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .network-role-grid,
    .network-projects-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }
  }

  @media (max-width: 700px) {
    .network-hero {
      padding: 76px 0 78px;
    }

    .network-section {
      padding: 72px 0;
    }

    .network-hero h1 {
      letter-spacing: -.045em;
    }

    .network-intro {
      font-size: 16px;
    }

