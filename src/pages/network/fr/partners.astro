---
import Network from "../../../layouts/Network.astro";

// Future Directus integration: replace with published partner records.
const partners = [
  {
    name: "Hivane Network",
    logo: "/hivane-network.png",
    description: "Hivane accompagne ABF Network dans le développement de son infrastructure numérique indépendante, en apportant des ressources d'hébergement et une expertise technique.",
    website: "https://hivane.net"
  }
];
---

<Network
  title="ABF Network — Nos partenaires"
  description="Découvrez les partenaires officiels qui accompagnent ABF Network et ses médias indépendants."
>
  <section class="partners-hero">
    <div class="network-container">
      <p class="eyebrow">ABF NETWORK / PARTENAIRES</p>
      <h1>Nos <span>partenaires.</span></h1>
      <p class="intro">
        Construire un réseau de médias indépendants grâce à des
        collaborations solides et des ambitions partagées.
      </p>
    </div>
  </section>

  <section class="partners-section" aria-labelledby="partners-title">
    <div class="network-container">
      <p class="eyebrow">NOTRE ÉCOSYSTÈME</p>
      <h2 id="partners-title">Plus forts ensemble.</h2>
      <p class="description">
        Découvrez les organisations qui accompagnent le développement
        d'ABF Network, Radio ABF, ABF 2 et ABF TV.
      </p>

      {partners.length > 0 ? (
        <div class="partners-grid">
          {partners.map((partner) => (
            <article class="partner-card">
              {partner.logo && (
                <img src={partner.logo} alt={partner.name} loading="lazy" />
              )}
              <h3>{partner.name}</h3>
              <p>{partner.description}</p>
              <a href={partner.website} target="_blank" rel="noopener noreferrer">
                Visiter le site ↗
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="partner-placeholder">
          <p>La présentation de nos partenaires officiels arrive prochainement.</p>
        </div>
      )}
    </div>
  </section>

  <section class="partners-section partners-dark">
    <div class="network-container">
      <p class="eyebrow">COLLABORONS ENSEMBLE</p>
      <h2>Construisons de nouveaux projets.</h2>
      <p class="description">
        Vous souhaitez soutenir les médias indépendants, la technologie
        et les projets créatifs ?
      </p>
      <div class="actions">
        <a class="primary" href="/network/fr/partnerships">
          Découvrir les partenariats ↗
        </a>
        <a href="mailto:contact@radioabf.com">
          Contacter ABF Network ↗
        </a>
      </div>
    </div>
  </section>
</Network>

<style>
  .partners-hero {
    padding: 112px 0 120px;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(148,163,184,.13), transparent 48%),
      linear-gradient(145deg, #17191e, #090a0c 72%);
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .eyebrow {
    margin: 0 0 22px;
    color: #aeb4c0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .24em;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 7.5vw, 104px);
    font-weight: 850;
    line-height: 1.03;
    letter-spacing: -.065em;
  }

  h1 span { color: #aeb4c0; }

  .intro {
    max-width: 720px;
    margin: 34px 0 0;
    color: #b8bdc7;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.7;
  }

  .partners-section {
    padding: 96px 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .partners-dark {
    background: linear-gradient(145deg, #111318, #08090b);
  }

  h2 {
    margin: 0;
    font-size: clamp(34px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -.045em;
  }

  .description {
    max-width: 740px;
    margin: 24px 0 36px;
    color: #b8bdc7;
    font-size: 17px;
    line-height: 1.8;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .partner-card,
  .partner-placeholder {
    padding: 32px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: rgba(255,255,255,.025);
  }

  .partner-card img {
    max-width: 220px;
    max-height: 110px;
    object-fit: contain;
  }

  .partner-card h3 { font-size: 24px; }

  .partner-card p,
  .partner-placeholder p {
    color: #aeb4c0;
    line-height: 1.7;
  }

  .partner-card a { color: #e5e7eb; }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .actions a {
    color: #d1d5db;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .actions .primary {
    padding: 14px 20px;
    border-radius: 8px;
    background: #e5e7eb;
    color: #101114;
  }

  @media (max-width: 900px) {
    .partners-hero { padding: 76px 0 84px; }
    .partners-section { padding: 72px 0; }
  }
</style>
