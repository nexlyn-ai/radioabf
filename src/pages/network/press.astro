---
import Network from "../../layouts/Network.astro";
---

<Network
  title="ABF Network — Press"
  description="Press information and official resources concerning ABF Network and its different media."
>
  <section class="network-hero">
    <div class="network-container">
      <p class="network-eyebrow">PRESS & MEDIA</p>

      <h1>Official<br /><span>network information.</span></h1>

      <p class="network-intro">
        ABF Network provides journalists and media professionals
        with essential information about its network,
        its media and projects.
      </p>
    </div>
  </section>

  <section class="network-section" aria-labelledby="press-title">
    <div class="network-container network-two-column">
      <div>
        <p class="network-eyebrow">ABF NETWORK</p>
        <h2 id="press-title">An independent media network.</h2>
      </div>

      <div class="network-copy">
        <p>
          ABF Network brings together several complementary media projects
          around shared infrastructure and organization.
        </p>

        <p>
          The network develops its own platforms, digital services
          and projects while allowing each medium
          to retain its editorial identity.
        </p>
      </div>
    </div>
  </section>

  <section class="network-section network-section-dark" aria-labelledby="media-title">
    <div class="network-container">
      <div class="network-section-heading">
        <p class="network-eyebrow">MEDIA PORTFOLIO</p>
        <h2 id="media-title">The network’s media.</h2>
      </div>

      <div class="network-press-grid">
        <article class="network-press-card radio">
          <span class="network-card-index">01 / RADIO</span>
          <h3>Radio ABF</h3>
          <strong>The DJs' Frequency</strong>
          <p>
            Radio dedicated to electronic music, DJ culture
            and DJ sets.
          </p>
          <a href="/">Visit Radio ABF <span aria-hidden="true">↗</span></a>
        </article>

        <article class="network-press-card abf2">
          <span class="network-card-index">02 / RADIO</span>
          <h3>ABF 2</h3>
          <strong>The Hits Frequency</strong>
          <p>
            Adult Contemporary radio dedicated to pop, rock,
            alternative and hits.
          </p>
          <a href="/abf2">Visit ABF 2 <span aria-hidden="true">↗</span></a>
        </article>

        <article class="network-press-card tv">
          <span class="network-card-index">03 / TV</span>
          <h3>ABF TV</h3>
          <strong>The Visual Frequency</strong>
          <p>
            Audiovisual project dedicated to visual culture, cinema,
            animation and digital creation.
          </p>
          <a href="/abftv">Visit ABF TV <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="network-section" aria-labelledby="resources-title">
    <div class="network-container network-resource-grid">
      <div>
        <p class="network-eyebrow">PRESS RESOURCES</p>
        <h2 id="resources-title">Resources and information.</h2>
        <p class="network-resource-intro">
          Public network information is available
          directly across the different official sites and spaces.
        </p>
      </div>

      <div class="network-resource-list">
        <a href="/network">
          <span>01</span>
          <div>
            <strong>ABF Network</strong>
            <small>General network presentation</small>
          </div>
          <b aria-hidden="true">↗</b>
        </a>

        <a href="/network/about">
          <span>02</span>
          <div>
            <strong>About</strong>
            <small>Network organization and identity</small>
          </div>
          <b aria-hidden="true">↗</b>
        </a>

        <a href="/network/technology">
          <span>03</span>
          <div>
            <strong>Technology</strong>
            <small>Infrastructure and technical approach</small>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  </section>

  <section class="network-section network-section-dark" aria-labelledby="contact-title">
    <div class="network-container network-contact-card">
      <p class="network-eyebrow">PRESS CONTACT</p>

      <h2 id="contact-title">Press inquiry?</h2>

      <p>
        For any request for information, interview, editorial collaboration
        or inquiry regarding the network, please contact ABF Network directly.
      </p>

      <a class="network-contact-button" href="mailto:contact@radioabf.com">
        Contact ABF Network
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Network>

<style>
  .network-hero {
    padding: 112px 0 120px;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(148,163,184,.13), transparent 48%),
      linear-gradient(145deg, #17191e, #090a0c 72%);
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .network-eyebrow {
    margin: 0 0 22px;
    color: #aeb4c0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .24em;
  }

  .network-hero h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(48px, 7.5vw, 104px);
    font-weight: 850;
    line-height: 1.03;
    letter-spacing: -.065em;
  }

  .network-hero h1 span {
    color: #aeb4c0;
  }

  .network-intro {
    max-width: 720px;
    margin: 34px 0 0;
    color: #b8bdc7;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.7;
  }

  .network-section {
    padding: 96px 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .network-section-dark {
    background: linear-gradient(145deg, #111318, #08090b);
  }

  .network-two-column {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: 80px;
    align-items: start;
  }

  .network-section h2 {
    margin: 0;
    color: #f3f4f6;
    font-size: clamp(34px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -.045em;
  }

  .network-copy {
    max-width: 720px;
    color: #b8bdc7;
    font-size: 17px;
    line-height: 1.8;
  }

  .network-copy p {
    margin: 0 0 24px;
  }

  .network-section-heading {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .network-press-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .network-press-card {
    min-height: 290px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: rgba(255,255,255,.025);
  }

  .network-press-card.radio {
    border-top: 2px solid rgba(47,194,255,.65);
  }

  .network-press-card.abf2 {
    border-top: 2px solid rgba(239,68,68,.65);
  }

  .network-press-card.tv {
    border-top: 2px solid rgba(168,85,247,.65);
  }

  .network-card-index {
    color: #8f96a3;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .18em;
  }

  .network-press-card h3 {
    margin: 40px 0 6px;
    color: #f3f4f6;
    font-size: 26px;
  }

  .network-press-card strong {
    color: #aeb4c0;
    font-size: 13px;
  }

  .network-press-card p {
    margin: 20px 0;
    color: #969eaa;
    font-size: 14px;
    line-height: 1.65;
  }

  .network-press-card a {
    margin-top: auto;
    color: #d8dce3;
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
  }

  .network-press-card a:hover {
    color: #fff;
  }

  .network-resource-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }

  .network-resource-intro {
    max-width: 600px;
    margin-top: 24px;
    color: #9da4b0;
    font-size: 16px;
    line-height: 1.7;
  }

  .network-resource-list {
    border-top: 1px solid rgba(255,255,255,.09);
  }

  .network-resource-list a {
    display: grid;
    grid-template-columns: 42px 1fr 20px;
    gap: 14px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid rgba(255,255,255,.09);
    color: inherit;
    text-decoration: none;
  }

  .network-resource-list a > span {
    color: #737b88;
    font-size: 11px;
    font-weight: 800;
  }

  .network-resource-list strong {
    display: block;
    color: #e5e7eb;
    font-size: 14px;
  }

  .network-resource-list small {
    display: block;
    margin-top: 5px;
    color: #818995;
    font-size: 12px;
  }

  .network-resource-list b {
    color: #8f96a3;
    font-size: 16px;
    font-weight: 500;
  }

  .network-resource-list a:hover strong,
  .network-resource-list a:hover b {
    color: #fff;
  }

  .network-contact-card {
    max-width: 920px;
  }

  .network-contact-card h2 {
    margin-top: 0;
  }

  .network-contact-card > p:not(.network-eyebrow) {
    max-width: 680px;
    margin: 24px 0 32px;
    color: #aeb4c0;
    font-size: 17px;
    line-height: 1.75;
  }

  .network-contact-button {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 8px;
    background: #e5e7eb;
    color: #101114;
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: transform .2s ease;
  }

  .network-contact-button:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .network-two-column,
    .network-resource-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .network-press-grid {
      grid-template-columns: 1fr;
    }

    .network-section {
      padding: 72px 0;
    }

    .network-hero {
      padding: 76px 0 84px;
    }
  }

  @media (max-width: 600px) {
    .network-press-card {
      padding: 24px;
    }

    .network-hero h1 {
      letter-spacing: -.045em;
    }
  }
</style>