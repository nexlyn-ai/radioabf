            );
        }

        if (!top.length) {
          top1Box?.classList.add(
            "hidden"
          );

          empty?.classList.remove(
            "hidden"
          );

          if (list) {
            list.innerHTML =
              "";
          }

          return;
        }

        empty?.classList.add(
          "hidden"
        );

        top1Box?.classList.remove(
          "hidden"
        );

        const first =
          top[0];

        const firstTrack =
          splitTrack(
            first?.track_key,
            first?.artist,
            first?.title
          );

        const a =
          document.querySelector(
            "#abf2Top1Artist"
          );

        const t =
          document.querySelector(
            "#abf2Top1Title"
          );

        const c =
          document.querySelector(
            "#abf2Top1Count"
          );

        const img =
          document.querySelector(
            "#abf2Top1Cover"
          );

        const fallback =
          img?.parentElement?.querySelector(
            ".abf2-cover-fallback"
          );

        if (a) {
          a.textContent =
            formatArtistName(
              firstTrack.artist
            ) ||
            "â€”";
        }

        if (t) {
          t.textContent =
            formatEnglishTitle(
              firstTrack.title
            ) ||
            "â€”";
        }

        if (c) {
          c.textContent =
            String(
              Number(
                first?.count
              ) ||
              0
            );
        }

        setImage(
          img,
          fallback,
          first?.cover_url ||
          ""
        );

        if (list) {
          list.innerHTML =
            top
              .slice(
                1,
                5
              )
              .map(
                (
                  row,
                  index
                ) => {
                  const tr =
                    splitTrack(
                      row?.track_key,
                      row?.artist,
                      row?.title
                    );

                  return `
                    <li>
                      <span class="abf2-mini-rank">#${index + 2}</span>

                      <span class="abf2-mini-copy">
                        <strong>${esc(formatArtistName(tr.artist) || "â€”")}</strong>
                        <span>${esc(formatEnglishTitle(tr.title) || "â€”")}</span>
                      </span>

                     <span class="abf2-mini-count">
						(<span class="abf2-vote-number">${Number(row?.count) || 0}</span>)
					 </span>
                    </li>
                  `;
                }
              )
              .join("");
        }
      }

      async function refreshABF2Home() {
        if (
          !isABF2Home()
        ) {
          return;
        }

        const week =
          getISOWeekId();

        const [
          np,
          votes
        ] =
          await Promise.all([
            fetchABF2NowPlaying(
              8
            ),

            fetchABF2Votes(
              week
            )
          ]);

        renderNow(
          np,
          votes.top
        );

       const currentTrack =
  splitTrack(
    np?.now?.raw,
    np?.now?.artist,
    np?.now?.title
  );

const currentKey =
  trackKey(
    currentTrack.artist,
    currentTrack.title
  );

const lastPlayed =
  (np.history || []).filter(
    (row) => {
      const historyTrack =
        splitTrack(
          row?.raw,
          row?.artist,
          row?.title
        );

      return (
        trackKey(
          historyTrack.artist,
          historyTrack.title
        ) !== currentKey
      );
    }
  );

renderLastPlayed(
  lastPlayed
);

        renderChart(
          votes
        );
      }

      function bindVoteButton() {
        const btn =
          document.querySelector(
            "#abf2NowVote"
          );

        if (
          !btn ||
          btn.dataset.bound === "1"
        ) {
          return;
        }

        btn.dataset.bound =
          "1";

        btn.addEventListener(
          "click",
          async () => {
            const artist =
              clean(
                btn.dataset.artist
              );

            const title =
              clean(
                btn.dataset.title
              );

            const msg =
              document.querySelector(
                "#abf2VoteMessage"
              );

            if (
              !artist &&
              !title
            ) {
              return;
            }

            btn.disabled =
              true;

            if (msg) {
              msg.textContent =
                "";

              msg.classList.add(
                "hidden"
              );
            }

            const result =
              await voteABF2({
                artist,
                title
              });

            if (result.ok) {
              if (msg) {
                msg.textContent =
                  "Vote counted. Thank you!";

                msg.classList.remove(
                  "hidden"
                );
              }

              await refreshABF2Home();
            } else {
              if (msg) {
                msg.textContent =
                  result.status === 409
                    ? "You already voted for this track today."
                    : (
                        result.error ||
                        "Unable to vote right now."
                      );

                msg.classList.remove(
                  "hidden"
                );
              }
            }

            btn.disabled =
              false;
          }
        );
      }



      /* =========================================================
         APPLY / RESTORE
         ========================================================= */

      function applyStation() {
        if (
          isABF2Page()
        ) {
          document
            .documentElement
            .classList
            .add(
              "abf2-theme"
            );

          setABF2Header();
          setABF2Streams();

          if (
            isABF2Home()
          ) {
            bindListenButton();
            bindVoteButton();
        }

          updateListenButton();

          return;
        }

        document
          .documentElement
          .classList
          .remove(
            "abf2-theme"
          );

        restoreABFHeader();
        restoreMainStation();
      }

      function stopHomeTimer() {
        if (
          state.timer
        ) {
          clearInterval(
            state.timer
          );
        }

        state.timer =
          null;
      }

      function startHomeTimer() {
        stopHomeTimer();

        if (
          !isABF2Home()
        ) {
          return;
        }

        state.timer =
          setInterval(
            () => {
              if (
                document.hidden
              ) {
                return;
              }

              refreshABF2Home();
            },
            30000
          );
      }

      function init() {
        applyStation();

        if (
          isABF2Home()
        ) {
          refreshABF2Home();
          startHomeTimer();
        } else {
          stopHomeTimer();
        }

        let attempts =
          0;

        const retry =
          setInterval(
            () => {
              attempts++;

              applyStation();

              const S =
                getPlayer();

              const playerLogo =
                document.querySelector(
                  "#playerFallbackLogo"
                );

              const fsLogo =
                document.querySelector(
                  "#fsFallbackLogo"
                );

              if (
                (
                  S?.audio &&
                  playerLogo &&
                  fsLogo
                ) ||
                attempts > 30
              ) {
                clearInterval(
                  retry
                );
              }
            },
            120
          );
      }

      if (
        !state.boundGlobal
      ) {
        state.boundGlobal =
          true;

        document.addEventListener(
          "astro:page-load",
          init
        );

        document.addEventListener(
          "astro:after-swap",
          () => {
            applyStation();

            if (
              isABF2Home()
            ) {
              refreshABF2Home();
              startHomeTimer();
            } else {
              stopHomeTimer();
            }
          }
        );

        document.addEventListener(
          "astro:before-swap",
          stopHomeTimer
        );

        document.addEventListener(
          "play",
          updateListenButton,
          true
        );

        document.addEventListener(
          "pause",
          updateListenButton,
          true
        );

        document.addEventListener(
          "visibilitychange",
          () => {
            if (
              document.hidden ||
              !isABF2Home()
            ) {
              return;
            }

            refreshABF2Home();
          }
        );
      }

      init();
    })();
  </script>
</Base>
