      /* =========================================================
         STREAMS
         ========================================================= */

      function setABF2Streams() {
        const S = getPlayer();

        if (!S) {
          return;
        }

        S.streams = ABF2_STREAMS.map(
          (stream) => ({
            ...stream
          })
        );

        S.__station = "abf2";

        if (!S.audio) {
          return;
        }

        const audio = S.audio;
        const index = getStreamIndex();

        const currentSrc =
          audio.currentSrc ||
          audio.src ||
          "";

        if (!currentSrc.includes("/abf2-")) {
          const wasPlaying = !audio.paused;

          audio.src = ABF2_STREAMS[index].url;
          audio.load();

          S.mode = "live";
          S.liveStreamIndex = index;
          S.currentStreamIndex = index;

          if (wasPlaying) {
            S.isStopped = false;

            audio.play().catch((error) => {
              console.warn(
                "[ABF2] Automatic stream switch playback failed",
                error
              );
            });
          }
        }
      }
      function setABFStreams() {
        const S =
          getPlayer();

        if (!S) {
          return;
        }

        S.streams =
          RADIO_ABF_STREAMS.map(
            (stream) => ({
              ...stream
            })
          );

        S.__station =
          "abf";
      }

      async function startABF2() {
        const S =
          getPlayer();

        if (
          !S ||
          !S.audio
        ) {
          setTimeout(
            startABF2,
            150
          );

          return;
        }

        setABF2Streams();

        const index =
          getStreamIndex();

        const audio =
          S.audio;

        if (
          !isABF2Audio(
            audio
          )
        ) {
          audio.src =
            ABF2_STREAMS[index].url;

          audio.load();
        }

        S.mode =
          "live";

        S.isStopped =
          false;

        try {
          await audio.play();
        } catch (error) {
          console.warn(
            "[ABF2] Playback error",
            error
          );
        }

        updateListenButton();
      }

      function restoreMainStation() {
        const S =
          getPlayer();

        if (!S) {
          return;
        }

        if (
          S.audio &&
          isABF2Audio(
            S.audio
          )
        ) {
          const wasPlaying =
            !S.audio.paused;

          const index =
            getStreamIndex();

          setABFStreams();

          S.audio.src =
            RADIO_ABF_STREAMS[index].url;

          S.audio.load();

          if (wasPlaying) {
            S.audio
              .play()
              .catch(
                () => {}
              );
          }
        } else {
          setABFStreams();
        }
      }

