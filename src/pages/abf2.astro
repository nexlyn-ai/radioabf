---
import Base from "../layouts/Base.astro";
import { directusGet, directusAsset } from "../lib/directus";

export const prerender = false;

type NewsItem = {
  id: number | string;
  status?: string | null;
  title?: string | null;
  slug?: string | null;
  excerpt?: string | null;
  cover?: string | null;
  published_at?: string | null;
  date_created?: string | null;
  category?: string | null;
};

type NewsResp = { data?: NewsItem[] };

let latestNews: NewsItem[] = [];

try {
  const fields = "id,status,title,slug,excerpt,cover,published_at,date_created,category";
  const resp = await directusGet<NewsResp>(
    `/items/news?fields=${encodeURIComponent(fields)}` +
      `&filter[status][_eq]=published` +
      `&sort=-published_at,-date_created&limit=3`
  );

  latestNews = Array.isArray(resp?.data) ? resp.data : [];
} catch (error) {
  console.error("[ABF2] Latest news fetch failed:", error);
  latestNews = [];
}

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=120, stale-while-revalidate=3600"
);

const fmtDate = (iso?: string | null) => {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
};
