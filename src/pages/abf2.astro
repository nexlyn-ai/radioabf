        );

        const yearStart =
          new Date(
            Date.UTC(
              date.getUTCFullYear(),
              0,
              1
            )
          );

        const weekNo =
          Math.ceil(
            (
              (
                (date - yearStart) /
                86400000
              ) +
              1
            ) /
            7
          );

        return `${date.getUTCFullYear()}-W${String(weekNo).padStart(2,"0")}`;
      }

      function formatTime(ts) {
        if (!ts) return "";

        const d =
          new Date(
            Number(ts)
          );

        if (
          Number.isNaN(
            d.getTime()
          )
        ) {
          return "";
        }

        return `${String(d.getHours()).padStart(2,"0")}:${String(d.getMinutes()).padStart(2,"0")}`;
      }

      function splitTrack(raw, artist = "", title = "") {
        const a =
          clean(artist);

        const t =
          clean(title);

        if (
          a ||
          t
        ) {
          return {
            artist: a,
            title: t
          };
        }

        const s =
          clean(raw)
            .replace(/\s+â€”\s+/g, " - ")
            .replace(/\s+â€“\s+/g, " - ");

        const idx =
          s.indexOf(" - ");

        if (
          idx === -1
        ) {
          return {
            artist: s,
            title: ""
          };
        }

        return {
          artist:
            clean(
              s.slice(
                0,
                idx
              )
            ),

          title:
            clean(
              s.slice(
                idx + 3
              )
            )
        };
      }

      /* =========================================================
         HOME TRACK DISPLAY NORMALIZATION
         ARTISTE - Titre (English title case)
         Affichage uniquement : aucune modification des donnÃ©es/API.
         ========================================================= */

      function formatArtistName(value) {
        return clean(value).toLocaleUpperCase("en-US");
      }

      function formatEnglishTitle(value) {
        const source = clean(value);

        if (!source) {
          return "";
        }

        const smallWords = new Set([
          "a",
          "an",
          "and",
          "as",
          "at",
          "but",
          "by",
          "for",
          "from",
          "in",
          "into",
          "nor",
          "of",
          "on",
          "or",
          "over",
          "per",
          "the",
          "to",
          "up",
          "via",
          "with",
          "yet"
        ]);

        const originalWords =
          source.split(/\s+/);

        const lowerWords =
          source
            .toLocaleLowerCase("en-US")
            .split(/\s+/);

        const capitalizeToken = (token) =>
          token.replace(
            /(^|[-/(\"'â€™\[])([a-zÃ -Ã¶Ã¸-Ã¿])/gi,
            (_, prefix, letter) =>
              prefix + letter.toLocaleUpperCase("en-US")
          );

        return lowerWords
          .map((word, index) => {
            const original =
              originalWords[index] || word;

            if (
              /^[A-Z0-9][A-Z0-9.&'+/-]{1,5}$/.test(original) &&
              /[A-Z]/.test(original)
            ) {
              return original;
            }

            const plain =
              word
                .replace(/^[^a-z0-9Ã -Ã¶Ã¸-Ã¿]+/i, "")
                .replace(/[^a-z0-9Ã -Ã¶Ã¸-Ã¿]+$/i, "");

            const previous =
              lowerWords[index - 1] || "";

            const startsNewPhrase =
              index === 0 ||
              /^[([{]/.test(word) ||
              /[:!?â€”â€“]$/.test(previous);

            const isLast =
              index === lowerWords.length - 1;

            if (
              !startsNewPhrase &&
              !isLast &&
              smallWords.has(plain)
            ) {
              return word;
            }

            return capitalizeToken(word);
          })
          .join(" ");
      }

      function trackKey(artist, title) {
        return `${clean(artist)} - ${clean(title)}`
          .toLowerCase()
          .replace(/\u00a0/g, " ")
          .replace(/\s+/g, " ")
          .replace(/[â€œâ€"']/g, "")
          .trim();
      }

      function setImage(img, fallback, url) {
        if (!img) return;

        const u =
          clean(url);

        img.onerror = () => {
          img.removeAttribute("src");
          img.classList.add("hidden");
          fallback?.classList.remove("hidden");
        };

        if (u) {
          img.src = u;
          img.classList.remove("hidden");
          fallback?.classList.add("hidden");
        } else {
          img.removeAttribute("src");
          img.classList.add("hidden");
          fallback?.classList.remove("hidden");
        }
      }

