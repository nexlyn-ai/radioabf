      async function fetchABF2NowPlaying(limit = 8) {
        try {
          const res =
            await fetch(
              `/api/nowplaying-abf2?limit=${limit}`,
              {
                cache: "no-store"
              }
            );

          const data =
            await res
              .json()
              .catch(
                () => ({})
              );

          if (
            !res.ok ||
            !data?.ok
          ) {
            return {
              now: null,
              history: []
            };
          }

          return {
            now:
              data.now ||
              null,

            history:
              Array.isArray(
                data.history
              )
                ? data.history
                : []
          };
        } catch {
          return {
            now: null,
            history: []
          };
        }
      }

      async function fetchABF2Votes(
        week =
          getISOWeekId()
      ) {
        try {
          const res =
            await fetch(
              `/api/vote-abf2?week=${encodeURIComponent(week)}`,
              {
                cache: "no-store"
              }
            );

          const data =
            await res
              .json()
              .catch(
                () => ({})
              );

          return {
            week:
              data?.week ||
              week,

            top:
              Array.isArray(
                data?.top
              )
                ? data.top
                : []
          };
        } catch {
          return {
            week,
            top: []
          };
        }
      }

      async function voteABF2(track) {
        const week =
          getISOWeekId();

        const res =
          await fetch(
            "/api/vote-abf2",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body:
                JSON.stringify({
                  week,
                  track_key:
                    trackKey(
                      track.artist,
                      track.title
                    ),

                  artist:
                    track.artist,

                  title:
                    track.title
                })
            }
          );

        const data =
          await res
            .json()
            .catch(
              () => ({})
            );

        return {
          ok:
            res.ok &&
            data?.ok !== false,

          status:
            res.status,

          error:
            data?.error ||
            ""
        };
      }

      function getVoteCount(top, artist, title) {
        const wanted =
          trackKey(
            artist,
            title
          );

        if (!wanted) {
          return 0;
        }

        for (
          const row
          of top || []
        ) {
          const split =
            splitTrack(
              row?.track_key,
              row?.artist,
              row?.title
            );

          if (
            trackKey(
              split.artist,
              split.title
            ) === wanted
          ) {
            return (
              Number(
                row?.count
              ) ||
              0
            );
          }
        }

        return 0;
      }

