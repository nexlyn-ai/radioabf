      function replaceHeaderText(from, to) {
        const header =
          document.querySelector(
            "#siteHeader"
          );

        if (!header) {
          return;
        }

        header
          .querySelectorAll(
            "div, span, p, strong"
          )
          .forEach((el) => {
            if (
              el.children.length
            ) {
              return;
            }

            if (
              clean(
                el.textContent
              ) === from
            ) {
              el.textContent =
                to;
            }
          });
      }

      function getHeaderNavs() {
        const header =
          document.querySelector(
            "#siteHeader"
          );

        if (!header) {
          return {
            desktop: null,
            mobile: null
          };
        }

        const mobile =
          header.querySelector(
            "#mobileNav"
          );

        const navs =
          Array.from(
            header.querySelectorAll(
              "nav"
            )
          );

        const desktop =
          navs.find(
            (n) =>
              n !== mobile
          ) ||
          null;

        return {
          desktop,
          mobile
        };
      }

      function saveOriginalMenu() {
        if (
          state.originalHeaderSaved
        ) {
          return;
        }

        const {
          desktop,
          mobile
        } =
          getHeaderNavs();

        if (desktop) {
          state.originalDesktopNav =
            desktop.innerHTML;
        }

        if (mobile) {
          state.originalMobileNav =
            mobile.innerHTML;
        }

        if (
          desktop ||
          mobile
        ) {
          state.originalHeaderSaved =
            true;
        }
      }

