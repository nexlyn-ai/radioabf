        originalMobileNav: "",
        originalHeaderSaved: false,
      };

      const clean = (v) => String(v ?? "").trim();

      const esc = (s) => String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

      const normalizePath = () =>
        window.location.pathname.replace(/\/+$/, "") || "/";

      const isABF2Page = () => {
        const path = normalizePath();
        return path === "/abf2" || path.startsWith("/abf2/");
      };

      const isABF2Home = () => normalizePath() === "/abf2";

      const getPlayer = () => window.__abf || null;

      const getStreamIndex = () => {
        let index = Number(localStorage.getItem("abf_stream_index"));

        if (
          !Number.isInteger(index) ||
          index < 0 ||
          index >= ABF2_STREAMS.length
        ) {
          index = 0;
        }

        return index;
      };

      const isABF2Audio = (audio) => {
        if (!audio) return false;

        const src =
          audio.currentSrc ||
          audio.src ||
          "";

        return src.includes("/abf2-");
      };

      function getISOWeekId(d = new Date()) {
        const date = new Date(
          Date.UTC(
            d.getFullYear(),
            d.getMonth(),
            d.getDate()
          )
        );

        const dayNum =
          date.getUTCDay() ||
          7;

        date.setUTCDate(
          date.getUTCDate() +
          4 -
          dayNum
        );

        const yearStart =
          new Date(
            Date.UTC(
              date.getUTCFullYear(),
              0,
              1
            )
          );

        const weekNo =
          Math.ceil(
            (
              (
                (date - yearStart) /
                86400000
              ) +
              1
            ) /
            7
          );

        return `${date.getUTCFullYear()}-W${String(weekNo).padStart(2,"0")}`;
      }

      function formatTime(ts) {
        if (!ts) return "";

        const d =
          new Date(
            Number(ts)
          );

        if (
          Number.isNaN(
            d.getTime()
          )
        ) {
          return "";
        }

        return `${String(d.getHours()).padStart(2,"0")}:${String(d.getMinutes()).padStart(2,"0")}`;
      }

      function splitTrack(raw, artist = "", title = "") {
        const a =
          clean(artist);

        const t =
          clean(title);

        if (
          a ||
          t
        ) {
          return {
            artist: a,
            title: t
          };
        }

        const s =
          clean(raw)
            .replace(/\s+—\s+/g, " - ")
            .replace(/\s+–\s+/g, " - ");

        const idx =
          s.indexOf(" - ");

        if (
          idx === -1
        ) {
          return {
            artist: s,
            title: ""
          };
        }

        return {
          artist:
            clean(
              s.slice(
                0,
                idx
              )
            ),

          title:
            clean(
              s.slice(
                idx + 3
              )
            )
        };
      }

      function trackKey(artist, title) {
        return `${clean(artist)} - ${clean(title)}`
          .toLowerCase()
          .replace(/\u00a0/g, " ")
          .replace(/\s+/g, " ")
          .replace(/[“”"']/g, "")
          .trim();
      }

      function setImage(img, fallback, url) {
        if (!img) return;

        const u =
          clean(url);

        img.onerror = () => {
          img.removeAttribute("src");
          img.classList.add("hidden");
          fallback?.classList.remove("hidden");
        };

        if (u) {
          img.src = u;
          img.classList.remove("hidden");
          fallback?.classList.add("hidden");
        } else {
          img.removeAttribute("src");
          img.classList.add("hidden");
          fallback?.classList.remove("hidden");
        }
      }

      /* =========================================================
         HEADER + ABF2 MENU
         ========================================================= */

      function replaceHeaderText(from, to) {
        const header =
          document.querySelector(
            "#siteHeader"
          );

        if (!header) {
          return;
        }

        header
          .querySelectorAll(
            "div, span, p, strong"
          )
          .forEach((el) => {
            if (
              el.children.length
            ) {
              return;
            }

            if (
              clean(
                el.textContent
              ) === from
            ) {
              el.textContent =
                to;
            }
          });
      }

      function getHeaderNavs() {
        const header =
          document.querySelector(
            "#siteHeader"
          );

        if (!header) {
          return {
            desktop: null,
            mobile: null
          };
        }

        const mobile =
          header.querySelector(
            "#mobileNav"
          );

        const navs =
          Array.from(
            header.querySelectorAll(
              "nav"
            )
          );

        const desktop =
          navs.find(
            (n) =>
              n !== mobile
          ) ||
          null;

        return {
          desktop,
          mobile
        };
      }

      function saveOriginalMenu() {
        if (
          state.originalHeaderSaved
        ) {
          return;
        }

        const {
          desktop,
          mobile
        } =
          getHeaderNavs();

        if (desktop) {
          state.originalDesktopNav =
            desktop.innerHTML;
        }

        if (mobile) {
          state.originalMobileNav =
            mobile.innerHTML;
        }

        if (
          desktop ||
          mobile
        ) {
          state.originalHeaderSaved =
            true;
        }
      }

