  }

  replaceHeaderText(
    "ABF 2",
    "RadioABF"
  );

  replaceHeaderText(
    "The Hits Frequency",
    "The DJs' Frequency"
  );

  restoreMainMenu();
}

      /* =========================================================
         STREAMS
         ========================================================= */

      function setABF2Streams() {
        const S =
          getPlayer();

        if (!S) {
          return;
        }

        S.streams =
          ABF2_STREAMS.map(
            (stream) => ({
              ...stream
            })
          );

        S.__station =
          "abf2";

        if (!S.audio) {
          return;
        }

        const index =
          getStreamIndex();

        const currentSrc =
          S.audio.currentSrc ||
          S.audio.src ||
          "";

        if (
          !currentSrc.includes(
            "/abf2-"
          )
        ) {
          S.audio.src =
            ABF2_STREAMS[index].url;

          S.audio.load();

          S.mode =
            "live";

          S.liveStreamIndex =
            index;

          S.currentStreamIndex =
            index;
        }
      }

      function setABFStreams() {
        const S =
          getPlayer();

        if (!S) {
          return;
        }

        S.streams =
          RADIO_ABF_STREAMS.map(
            (stream) => ({
              ...stream
            })
          );

        S.__station =
          "abf";
      }

      async function startABF2() {
        const S =
          getPlayer();

        if (
          !S ||
          !S.audio
        ) {
          setTimeout(
            startABF2,
            150
          );

          return;
        }

        setABF2Streams();

        const index =
          getStreamIndex();

        const audio =
          S.audio;

        if (
          !isABF2Audio(
            audio
          )
        ) {
          audio.src =
            ABF2_STREAMS[index].url;

          audio.load();
        }

        S.mode =
          "live";

        S.isStopped =
          false;

        try {
          await audio.play();
        } catch (error) {
          console.warn(
            "[ABF2] Playback error",
            error
          );
        }

        updateListenButton();
      }

      function restoreMainStation() {
        const S =
          getPlayer();

        if (!S) {
          return;
        }

        if (
          S.audio &&
          isABF2Audio(
            S.audio
          )
        ) {
          const wasPlaying =
            !S.audio.paused;

          const index =
            getStreamIndex();

          setABFStreams();

          S.audio.src =
            RADIO_ABF_STREAMS[index].url;

          S.audio.load();

          if (wasPlaying) {
            S.audio
              .play()
              .catch(
                () => {}
              );
          }
        } else {
          setABFStreams();
        }
      }

      function updateListenButton() {
        const button =
          document.querySelector(
            "#abf2ListenLive"
          );

        if (!button) {
          return;
        }

        const S =
          getPlayer();

        const audio =
          S?.audio;

        const playing =
          !!audio &&
          !audio.paused &&
          isABF2Audio(
            audio
          );

        button.classList.toggle(
          "is-playing",
          playing
        );

        const label =
          button.querySelector(
            "span:last-child"
          );

        if (label) {
          label.textContent =
            playing
              ? "On Air"
              : "Listen Live";
        }
      }

      function bindListenButton() {
        const button =
          document.querySelector(
            "#abf2ListenLive"
          );

        if (!button) {
          return;
        }

        if (
          button.dataset.bound !== "1"
        ) {
          button.dataset.bound =
            "1";

          button.addEventListener(
            "click",
            startABF2
          );
        }

        updateListenButton();
      }

      /* =========================================================
         ABF2 DATA
         ========================================================= */

      async function fetchABF2NowPlaying(limit = 8) {
        try {
          const res =
            await fetch(
              `/api/nowplaying-abf2?limit=${limit}`,
              {
                cache: "no-store"
              }
            );

          const data =
            await res
              .json()
              .catch(
                () => ({})
              );

          if (
            !res.ok ||
            !data?.ok
          ) {
            return {
              now: null,
              history: []
            };
          }

          return {
            now:
              data.now ||
              null,

            history:
              Array.isArray(
                data.history
              )
                ? data.history
                : []
          };
        } catch {
          return {
            now: null,
            history: []
          };
        }
      }

      async function fetchABF2Votes(
        week =
          getISOWeekId()
      ) {
        try {
          const res =
            await fetch(
              `/api/vote-abf2?week=${encodeURIComponent(week)}`,
              {
                cache: "no-store"
              }
            );

          const data =
            await res
              .json()
              .catch(
                () => ({})
              );

          return {
            week:
              data?.week ||
              week,

            top:
              Array.isArray(
                data?.top
              )
                ? data.top
                : []
          };
        } catch {
          return {
            week,
            top: []
          };
        }
      }

      async function voteABF2(track) {
        const week =
          getISOWeekId();

        const res =
          await fetch(
            "/api/vote-abf2",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body:
                JSON.stringify({
                  week,
                  track_key:
                    trackKey(
                      track.artist,
                      track.title
                    ),

                  artist:
                    track.artist,

                  title:
                    track.title
                })
            }
          );

        const data =
          await res
            .json()
            .catch(
              () => ({})
            );

        return {
          ok:
            res.ok &&
            data?.ok !== false,

          status:
            res.status,

          error:
            data?.error ||
            ""
        };
      }

      function getVoteCount(top, artist, title) {
        const wanted =
          trackKey(
            artist,
            title
          );

        if (!wanted) {
          return 0;
        }

        for (
          const row
          of top || []
        ) {
          const split =
            splitTrack(
              row?.track_key,
              row?.artist,
              row?.title
            );

          if (
            trackKey(
              split.artist,
              split.title
            ) === wanted
          ) {
            return (
              Number(
                row?.count
              ) ||
              0
            );
          }
        }

        return 0;
      }

      function renderNow(data, top) {
        const now =
          data?.now ||
          null;

        const artistEl =
          document.querySelector(
            "#abf2NowArtist"
          );

        const titleEl =
          document.querySelector(
            "#abf2NowTitle"
          );

        const timeEl =
          document.querySelector(
            "#abf2NowTime"
          );

        const countEl =
          document.querySelector(
            "#abf2NowVoteCount"
          );

        const voteBtn =
          document.querySelector(
            "#abf2NowVote"
          );

        const img =
          document.querySelector(
            "#abf2NowCover"
          );

        const fallback =
          document.querySelector(
            "#abf2NowFallback"
          );

        if (
          !artistEl ||
          !titleEl
        ) {
          return;
        }

        const track =
          splitTrack(
            now?.raw,
            now?.artist,
            now?.title
          );

        artistEl.textContent =
          track.artist ||
          "—";

        titleEl.textContent =
          track.title ||
          "—";

        if (timeEl) {
  timeEl.textContent =
    "Live on ABF 2";
}

        setImage(
          img,
          fallback,
          now?.cover_url ||
          ""
        );

        const count =
          getVoteCount(
            top,
            track.artist,
            track.title
          );

        if (countEl) {
          countEl.textContent =
            String(
              count
            );
        }

        if (voteBtn) {
          const valid =
            !!(
              track.artist ||
              track.title
            );

          voteBtn.disabled =
            !valid;

          voteBtn.dataset.artist =
            track.artist ||
            "";

          voteBtn.dataset.title =
            track.title ||
            "";
        }
      }

      function renderLastPlayed(history) {
        const host =
          document.querySelector(
            "#abf2LastPlayed"
          );

        const empty =
          document.querySelector(
            "#abf2LastEmpty"
          );

        if (!host) {
          return;
        }

        const rows =
          (history || [])
            .slice(
              0,
              4
            );

        if (
          !rows.length
        ) {
          host.innerHTML =
            "";

          empty?.classList.remove(
            "hidden"
          );

          return;
        }

        empty?.classList.add(
          "hidden"
        );

        host.innerHTML =
          rows
            .map(
              (row) => {
                const track =
                  splitTrack(
                    row?.raw,
                    row?.artist,
                    row?.title
                  );

                const cover =
                  clean(
                    row?.cover_url
                  );

                return `
                  <div class="abf2-last-card">
                    <div class="abf2-cover abf2-cover-small">
                      ${
                        cover
                          ? `<img src="${esc(cover)}" alt="" loading="lazy" decoding="async" />`
                          : ""
                      }

                      <div
                        class="abf2-cover-fallback"
                        ${cover ? 'style="display:none"' : ""}
                      >
                        <img
                          src="/logo-abf2.png"
                          alt="ABF 2"
                        />
                      </div>
                    </div>

                    <div class="abf2-last-copy">
                      <strong>${esc(track.artist || "—")}</strong>
                      <span>${esc(track.title || "—")}</span>
                      
                    </div>
                  </div>
                `;
              }
            )
            .join("");
      }

      function renderChart(votes) {
        const week =
          votes?.week ||
          getISOWeekId();

        const top =
          Array.isArray(
            votes?.top
          )
            ? votes.top
            : [];

        const weekEl =
          document.querySelector(
            "#abf2WeekLabel"
          );

        const top1Box =
          document.querySelector(
            "#abf2Top1"
          );

        const empty =
          document.querySelector(
            "#abf2TopEmpty"
          );

        const list =
          document.querySelector(
            "#abf2MiniChart"
          );

        if (weekEl) {
          weekEl.textContent =
            week.replace(
              "-W",
              " W"
            );
        }

        if (!top.length) {
          top1Box?.classList.add(
            "hidden"
          );

          empty?.classList.remove(
            "hidden"
          );

          if (list) {
            list.innerHTML =
              "";
          }

          return;
        }

        empty?.classList.add(
          "hidden"
        );

        top1Box?.classList.remove(
          "hidden"
        );

        const first =
          top[0];

        const firstTrack =
          splitTrack(
            first?.track_key,
            first?.artist,
            first?.title
          );

        const a =
          document.querySelector(
            "#abf2Top1Artist"
          );

        const t =
          document.querySelector(
            "#abf2Top1Title"
          );

        const c =
          document.querySelector(
            "#abf2Top1Count"
          );

        const img =
          document.querySelector(
            "#abf2Top1Cover"
          );

        const fallback =
          img?.parentElement?.querySelector(
            ".abf2-cover-fallback"
          );

        if (a) {
          a.textContent =
            firstTrack.artist ||
            "—";
        }

        if (t) {
          t.textContent =
            firstTrack.title ||
            "—";
        }

        if (c) {
          c.textContent =
            String(
              Number(
                first?.count
              ) ||
              0
            );
        }

        setImage(
          img,
          fallback,
          first?.cover_url ||
          ""
        );

        if (list) {
          list.innerHTML =
            top
              .slice(
                1,
                5
              )
              .map(
                (
                  row,
                  index
                ) => {
                  const tr =
                    splitTrack(
                      row?.track_key,
                      row?.artist,
                      row?.title
                    );

                  return `
                    <li>
                      <span class="abf2-mini-rank">#${index + 2}</span>

                      <span class="abf2-mini-copy">
                        <strong>${esc(tr.artist || "—")}</strong>
                        <span>${esc(tr.title || "—")}</span>
                      </span>

                      <span class="abf2-mini-count">
                        ${Number(row?.count) || 0}
                      </span>
                    </li>
                  `;
                }
              )
              .join("");
        }
      }

      async function refreshABF2Home() {
        if (
          !isABF2Home()
        ) {
          return;
        }

        const week =
          getISOWeekId();

        const [
          np,
          votes
        ] =
          await Promise.all([
            fetchABF2NowPlaying(
              8
            ),

            fetchABF2Votes(
              week
            )
          ]);

        renderNow(
          np,
          votes.top
        );

       const currentTrack =
  splitTrack(
    np?.now?.raw,
    np?.now?.artist,
    np?.now?.title
  );

const currentKey =
  trackKey(
    currentTrack.artist,
    currentTrack.title
  );

const lastPlayed =
  (np.history || []).filter(
    (row) => {
      const historyTrack =
        splitTrack(
          row?.raw,
          row?.artist,
          row?.title
        );

      return (
        trackKey(
          historyTrack.artist,
          historyTrack.title
        ) !== currentKey
      );
    }
  );

renderLastPlayed(
  lastPlayed
);

        renderChart(
          votes
        );
      }

      function bindVoteButton() {
        const btn =
          document.querySelector(
            "#abf2NowVote"
          );

        if (
          !btn ||
          btn.dataset.bound === "1"
        ) {
          return;
        }

        btn.dataset.bound =
          "1";

        btn.addEventListener(
          "click",
          async () => {
            const artist =
              clean(
                btn.dataset.artist
              );

            const title =
              clean(
                btn.dataset.title
              );

            const msg =
              document.querySelector(
                "#abf2VoteMessage"
              );

            if (
              !artist &&
              !title
            ) {
              return;
            }

            btn.disabled =
              true;

            if (msg) {
              msg.textContent =
                "";

              msg.classList.add(
                "hidden"
              );
            }

            const result =
              await voteABF2({
                artist,
                title
              });

            if (result.ok) {
              if (msg) {
                msg.textContent =
                  "Vote counted. Thank you!";

                msg.classList.remove(
                  "hidden"
                );
              }

              await refreshABF2Home();
            } else {
              if (msg) {
                msg.textContent =
                  result.status === 409
                    ? "You already voted for this track today."
                    : (
                        result.error ||
                        "Unable to vote right now."
                      );

                msg.classList.remove(
                  "hidden"
                );
              }
            }

            btn.disabled =
              false;
          }
        );
      }

      /* =========================================================
         BACK TO TOP
         ========================================================= */

      function bindBackToTop() {
        const btn =
          document.querySelector(
            "#abf2BackToTop"
          );

        if (!btn) {
          return;
        }

        const update =
          () => {
            btn.classList.toggle(
              "visible",
              window.scrollY > 420
            );
          };

        if (
          btn.dataset.bound !== "1"
        ) {
          btn.dataset.bound =
            "1";

          btn.addEventListener(
            "click",
            () => {
              window.scrollTo({
                top: 0,
                behavior: "smooth"
              });
            }
          );

          window.addEventListener(
            "scroll",
            update,
            {
              passive: true
            }
          );
        }

        update();
      }

   /* =========================================================
   APPLY / RESTORE
   ========================================================= */

function applyStation() {
  if (
    isABF2Page()
  ) {
    document
      .documentElement
      .classList
      .add(
        "abf2-theme"
      );

    setABF2Header();
    setABF2Streams();

    if (
      isABF2Home()
    ) {
      bindListenButton();
      bindVoteButton();
      bindBackToTop();
    }

    updateListenButton();

    return;
  }

  document
    .documentElement
    .classList
    .remove(
      "abf2-theme"
    );

  restoreABFHeader();
  restoreMainStation();
}

function stopHomeTimer() {
  if (
    state.timer
  ) {
    clearInterval(
      state.timer
    );
  }

  state.timer =
    null;
}

function startHomeTimer() {
  stopHomeTimer();

  if (
    !isABF2Home()
  ) {
    return;
  }

  state.timer =
    setInterval(
      () => {
        if (
          document.hidden
        ) {
          return;
        }

        refreshABF2Home();
      },
      30000
    );
}

function init() {
  applyStation();

  if (
    isABF2Home()
  ) {
    refreshABF2Home();
    startHomeTimer();
  } else {
    stopHomeTimer();
  }

  let attempts =
    0;

  const retry =
    setInterval(
      () => {
        attempts++;

        applyStation();

        const S =
          getPlayer();

        const playerLogo =
          document.querySelector(
            "#playerFallbackLogo"
          );

        const fsLogo =
          document.querySelector(
            "#fsFallbackLogo"
          );

        if (
          (
            S?.audio &&
            playerLogo &&
            fsLogo
          ) ||
          attempts > 30
        ) {
          clearInterval(
            retry
          );
        }
      },
      120
    );
}

if (
  !state.boundGlobal
) {
  state.boundGlobal =
    true;

  document.addEventListener(
    "astro:page-load",
    init
  );

  document.addEventListener(
    "astro:after-swap",
    () => {
      applyStation();

      if (
        isABF2Home()
      ) {
        refreshABF2Home();
        startHomeTimer();
      } else {
        stopHomeTimer();
      }
    }
  );

  document.addEventListener(
    "astro:before-swap",
    stopHomeTimer
  );

  document.addEventListener(
    "play",
    updateListenButton,
    true
  );

  document.addEventListener(
    "pause",
    updateListenButton,
    true
  );

  document.addEventListener(
    "visibilitychange",
    () => {
      if (
        document.hidden ||
        !isABF2Home()
      ) {
        return;
      }

      refreshABF2Home();
    }
  );
}

init();
})();
</script>
