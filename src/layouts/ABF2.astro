---
import Base from "./Base.astro";

export const prerender = false;

const {
  title = "ABF 2 — Alternative Bass Fréquence | The Hits Frequency",
  description = "ABF 2 — The Hits Frequency. Pop, rock, alternative, classics, 80s, 90s and today's hits.",
  canonical,
  image = "/og-image.jpg",
} = Astro.props;
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image={image}
>
  <slot />

  <style>
    :root {
      --abf2-red: #ff3150;
      --abf2-red-soft: #ff7188;
      --abf2-red-dark: #9e001f;
      --abf2-bg: #05070b;
    }

    .abf2-page {
      min-height: 100vh;
      color: #fff;
      background:
        radial-gradient(circle at 18% 0%, rgba(255,49,80,.10), transparent 25%),
        radial-gradient(circle at 82% 38%, rgba(140,0,30,.06), transparent 30%),
        #05070b;
      overflow: hidden;
    }

    .abf2-shell {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
    }

    .abf2-section {
      padding: 40px 0;
    }

    .abf2-section-top {
      padding-top: 34px;
    }

    .abf2-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
      padding: 14px 16px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 18px;
      background: rgba(255,255,255,.025);
      backdrop-filter: blur(12px);
    }

    .abf2-brand-mini {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .abf2-brand-mini img {
      width: 52px;
      height: 52px;
      object-fit: contain;
      filter: drop-shadow(0 0 14px rgba(255,49,80,.28));
    }

    .abf2-brand-title {
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: -.02em;
    }

    .abf2-brand-claim {
      margin-top: 2px;
      color: var(--abf2-red);
      font-size: 11px;
      font-weight: 800;
    }

    .abf2-top-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .abf2-primary-btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 17px;
      border-radius: 13px;
      border: 1px solid rgba(255,49,80,.45);
      background: linear-gradient(135deg, #9e001f, #ff3150);
      color: #fff;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 12px 30px rgba(255,49,80,.16);
      transition: .18s ease;
    }

    .abf2-primary-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 15px 36px rgba(255,49,80,.24);
    }

    .abf2-primary-btn.is-playing {
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.05),
        0 14px 38px rgba(255,49,80,.28);
    }

    .abf2-live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 11px rgba(255,255,255,.8);
    }

    .abf2-primary-btn.is-playing .abf2-live-dot {
      animation: abf2Pulse 1.35s ease-in-out infinite;
    }

    @keyframes abf2Pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50% { opacity: .35; transform: scale(.75); }
    }

    .abf2-station-switch {
      min-height: 46px;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 0 14px;
      border-radius: 13px;
      border: 1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      color: #fff;
      text-decoration: none;
      transition: .18s ease;
    }

    .abf2-station-switch:hover {
      border-color: rgba(255,49,80,.28);
      background: rgba(255,49,80,.055);
    }

    .abf2-station-switch strong,
    .abf2-station-switch small {
      display: block;
    }

    .abf2-station-switch strong {
      font-size: 11px;
    }

    .abf2-station-switch small {
      margin-top: 2px;
      color: rgba(255,255,255,.42);
      font-size: 9px;
    }

    .station-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex: none;
    }

    .station-dot-blue {
      background: #2fc2ff;
      box-shadow: 0 0 13px rgba(47,194,255,.75);
    }

    .station-dot-red {
      background: #ff3150;
      box-shadow: 0 0 13px rgba(255,49,80,.85);
    }

    .abf2-main-grid,
    .abf2-sound-grid {
      display: grid;
      grid-template-columns: 1.45fr .85fr;
      gap: 20px;
      align-items: stretch;
    }

    .abf2-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 24px;
      background:
        radial-gradient(circle at 12% 0%, rgba(255,49,80,.055), transparent 35%),
        linear-gradient(145deg, rgba(255,255,255,.05), rgba(255,255,255,.018));
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.025),
        0 30px 70px rgba(0,0,0,.18);
    }

    .abf2-now-card,
    .abf2-top-card,
    .abf2-sound-card,
    .abf2-network-card {
      padding: 26px;
    }

    .abf2-card-head,
    .abf2-section-title {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
    }

    .abf2-kicker {
      color: var(--abf2-red);
      text-transform: uppercase;
      letter-spacing: .20em;
      font-size: 10px;
      font-weight: 900;
    }

    .abf2-card-head h1,
    .abf2-card-head h2,
    .abf2-section-title h2,
    .abf2-sound-card h2,
    .abf2-network-card h2 {
      margin: 6px 0 0;
      font-size: clamp(1.7rem, 2.7vw, 2.55rem);
      letter-spacing: -.04em;
      line-height: 1;
    }

    .abf2-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      color: #ffc8d2;
      border: 1px solid rgba(255,49,80,.25);
      background: rgba(255,49,80,.09);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .12em;
    }

    .abf2-live-badge span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--abf2-red);
      box-shadow: 0 0 11px rgba(255,49,80,.9);
      animation: abf2Pulse 1.4s ease-in-out infinite;
    }

    .abf2-now-layout {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 24px;
    }

    .abf2-cover {
      position: relative;
      flex: none;
      overflow: hidden;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,.10);
      background: #16090e;
      box-shadow: 0 18px 48px rgba(0,0,0,.25);
    }

    .abf2-cover-main {
      width: 190px;
      height: 190px;
    }

    .abf2-cover-medium {
      width: 76px;
      height: 76px;
      border-radius: 15px;
    }

    .abf2-cover-small {
      width: 60px;
      height: 60px;
      border-radius: 14px;
    }

    .abf2-cover > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .abf2-cover-fallback {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 35% 25%, rgba(255,49,80,.24), transparent 42%),
        #16090e;
    }

    .abf2-cover-fallback img {
      width: 60%;
      height: 60%;
      object-fit: contain;
      opacity: .88;
    }

    .hidden {
      display: none !important;
    }

    .abf2-now-copy {
      min-width: 0;
      flex: 1;
    }

    .abf2-now-artist {
      font-size: clamp(1.7rem, 3vw, 2.65rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.04;
      overflow-wrap: anywhere;
    }

    .abf2-now-title {
      margin-top: 8px;
      color: rgba(255,255,255,.63);
      font-size: 1.08rem;
      line-height: 1.4;
    }

    .abf2-now-time {
      margin-top: 11px;
      color: rgba(255,255,255,.40);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .11em;
    }

    .abf2-now-actions {
      display: flex;
      align-items: center;
      gap: 13px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .abf2-vote-btn {
      min-height: 40px;
      padding: 0 14px;
      border-radius: 12px;
      border: 1px solid rgba(255,49,80,.22);
      background: rgba(255,49,80,.08);
      color: #fff;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .16s ease;
    }

    .abf2-vote-btn:hover {
      border-color: rgba(255,49,80,.50);
      background: rgba(255,49,80,.14);
    }

    .abf2-vote-btn:disabled {
      opacity: .55;
      cursor: wait;
    }

    .abf2-text-link {
      color: #ff7188;
      text-decoration: none;
      font-size: 12px;
      font-weight: 800;
    }

    .abf2-text-link:hover {
      color: #ff9bad;
    }

    .abf2-inline-message {
      margin-top: 11px;
      color: rgba(255,255,255,.62);
      font-size: 12px;
    }

    .abf2-week-badge {
      padding: 7px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.03);
      color: rgba(255,255,255,.56);
      font-size: 10px;
      font-weight: 800;
    }

    .abf2-top1 {
      display: grid;
      grid-template-columns: 38px 76px minmax(0,1fr);
      gap: 12px;
      align-items: center;
      margin-top: 24px;
      padding: 13px;
      border-radius: 18px;
      border: 1px solid rgba(255,49,80,.15);
      background: rgba(255,49,80,.045);
    }

    .abf2-rank {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 12px;
      border: 1px solid rgba(255,49,80,.24);
      color: #ff9aaa;
      background: rgba(255,49,80,.08);
      font-size: 11px;
      font-weight: 900;
    }

    .abf2-top1-copy {
      min-width: 0;
    }

    .abf2-top1-artist,
    .abf2-top1-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .abf2-top1-artist {
      font-size: 12px;
      font-weight: 900;
    }

    .abf2-top1-title {
      margin-top: 4px;
      color: rgba(255,255,255,.56);
      font-size: 10px;
    }

    .abf2-top1-count {
      margin-top: 7px;
      color: #ff8295;
      font-size: 10px;
      font-weight: 800;
    }

    .abf2-mini-chart {
      list-style: none;
      padding: 0;
      margin: 12px 0 0;
    }

    .abf2-mini-chart li {
      display: grid;
      grid-template-columns: 26px minmax(0,1fr) auto;
      gap: 9px;
      align-items: center;
      padding: 10px 1px;
      border-top: 1px solid rgba(255,255,255,.05);
    }

    .abf2-mini-rank {
      color: rgba(255,255,255,.34);
      font-size: 9px;
      font-weight: 900;
    }

    .abf2-mini-copy {
      min-width: 0;
    }

    .abf2-mini-copy strong,
    .abf2-mini-copy span {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .abf2-mini-copy strong {
      font-size: 10px;
    }

    .abf2-mini-copy span {
      margin-top: 2px;
      color: rgba(255,255,255,.40);
      font-size: 9px;
    }

    .abf2-mini-count {
      color: #ff8295;
      font-size: 9px;
      font-weight: 800;
    }

    .abf2-empty {
      margin-top: 17px;
      color: rgba(255,255,255,.47);
      font-size: 12px;
    }

    .abf2-empty-card {
      padding: 26px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,.07);
      background: rgba(255,255,255,.022);
      color: rgba(255,255,255,.48);
      font-size: 12px;
    }

    .abf2-section-title {
      align-items: end;
      margin-bottom: 18px;
    }

    .abf2-last-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 12px;
    }

    .abf2-last-card {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
      padding: 12px;
      border-radius: 17px;
      border: 1px solid rgba(255,255,255,.07);
      background: rgba(255,255,255,.022);
    }

    .abf2-last-copy {
      min-width: 0;
    }

    .abf2-last-copy strong,
    .abf2-last-copy span {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .abf2-last-copy strong {
      font-size: 11px;
    }

    .abf2-last-copy span {
      margin-top: 3px;
      color: rgba(255,255,255,.44);
      font-size: 9px;
    }

    .abf2-news-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 15px;
    }

    .abf2-news-card {
      overflow: hidden;
      border-radius: 21px;
      border: 1px solid rgba(255,255,255,.075);
      background: rgba(255,255,255,.022);
      color: #fff;
      text-decoration: none;
      transition: .18s ease;
    }

    .abf2-news-card:hover {
      transform: translateY(-3px);
      border-color: rgba(255,49,80,.22);
      background: rgba(255,49,80,.03);
    }

    .abf2-news-cover {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #16090e;
    }

    .abf2-news-cover > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .abf2-news-fallback {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 50% 30%, rgba(255,49,80,.20), transparent 50%),
        #16090e;
    }

    .abf2-news-fallback img {
      width: 30%;
      opacity: .82;
    }

    .abf2-news-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(5,7,11,.72), transparent 58%);
    }

    .abf2-news-tag {
      position: absolute;
      left: 12px;
      bottom: 11px;
      padding: 5px 8px;
      border-radius: 999px;
      border: 1px solid rgba(255,49,80,.30);
      background: rgba(75,0,15,.74);
      color: #ffb0bd;
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .11em;
    }

    .abf2-news-copy {
      padding: 16px;
    }

    .abf2-news-date {
      color: rgba(255,255,255,.36);
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: .11em;
    }

    .abf2-news-copy h3 {
      margin: 8px 0 0;
      font-size: 1rem;
      line-height: 1.25;
    }

    .abf2-news-copy p {
      margin: 8px 0 0;
      color: rgba(255,255,255,.53);
      font-size: 11px;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .abf2-news-read {
      display: inline-block;
      margin-top: 13px;
      color: #ff7188;
      font-size: 10px;
      font-weight: 800;
    }

    .abf2-sound-card p {
      max-width: 680px;
      margin: 15px 0 0;
      color: rgba(255,255,255,.56);
      line-height: 1.65;
      font-size: 13px;
    }

    .abf2-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .abf2-tags span {
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,49,80,.18);
      background: rgba(255,49,80,.05);
      color: rgba(255,255,255,.70);
      font-size: 9px;
      font-weight: 800;
    }

    .abf2-network-row {
      display: grid;
      grid-template-columns: 12px minmax(0,1fr) auto;
      gap: 11px;
      align-items: center;
      margin-top: 11px;
      padding: 14px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.07);
      background: rgba(255,255,255,.022);
      color: #fff;
      text-decoration: none;
    }

    .abf2-network-row.current {
      border-color: rgba(255,49,80,.15);
      background: rgba(255,49,80,.033);
    }

    .abf2-network-row strong,
    .abf2-network-row small {
      display: block;
    }

    .abf2-network-row strong {
      font-size: 11px;
    }

    .abf2-network-row small {
      margin-top: 2px;
      color: rgba(255,255,255,.40);
      font-size: 9px;
    }

    .abf2-network-arrow,
    .abf2-network-current {
      color: rgba(255,255,255,.34);
      font-size: 9px;
      font-weight: 900;
    }

    .abf2-network-current {
      color: #ff7188;
    }

    .abf2-signature {
      padding: 30px 0 105px;
    }

    .abf2-signature-card {
      min-height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 22px;
      text-align: left;
      border-radius: 24px;
      border: 1px solid rgba(255,49,80,.12);
      background:
        radial-gradient(circle at 50% 0%, rgba(255,49,80,.085), transparent 58%),
        rgba(255,255,255,.015);
    }

    .abf2-signature-card img {
      width: 76px;
      filter: drop-shadow(0 0 14px rgba(255,49,80,.20));
    }

    .abf2-signature-card span,
    .abf2-signature-card strong {
      display: block;
    }

    .abf2-signature-card span {
      color: rgba(255,255,255,.38);
      font-size: 9px;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .abf2-signature-card strong {
      margin-top: 4px;
      font-size: clamp(1.45rem, 3vw, 2.4rem);
      letter-spacing: -.04em;
    }

    .abf2-back-to-top {
      position: fixed;
      right: 22px;
      bottom: 112px;
      z-index: 80;
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1px solid rgba(255,49,80,.28);
      background: rgba(18,7,12,.90);
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: .2s ease;
      box-shadow: 0 12px 35px rgba(255,49,80,.16);
      backdrop-filter: blur(12px);
    }

    .abf2-back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .abf2-back-to-top:hover {
      background: rgba(255,49,80,.18);
      border-color: rgba(255,49,80,.52);
    }

    /* =========================================================
       ABF 2 RED GLOBAL SKIN
       ========================================================= */

    :global(html.abf2-theme) {
      --abf-accent: #ff3150 !important;
      --accent: #ff3150 !important;
      --primary: #ff3150 !important;
      scrollbar-color: #ff3150 #090b10;
    }

    :global(html.abf2-theme body) {
      --abf-accent: #ff3150 !important;
      --accent: #ff3150 !important;
      --primary: #ff3150 !important;
    }

    :global(html.abf2-theme ::selection) {
      background: rgba(255,49,80,.35);
      color: #fff;
    }

    :global(html.abf2-theme #siteHeader) {
      --abf-accent: #ff3150 !important;
      border-color: rgba(255,49,80,.15) !important;
    }

    :global(html.abf2-theme #siteHeader a:hover),
    :global(html.abf2-theme #siteHeader button:hover) {
      color: #ff3150 !important;
    }

    :global(html.abf2-theme #abfBrandLogo) {
      filter: drop-shadow(0 0 14px rgba(255,49,80,.48)) !important;
    }

    :global(html.abf2-theme #siteHeader .from-cyan-400),
    :global(html.abf2-theme #siteHeader .via-blue-400),
    :global(html.abf2-theme #siteHeader .to-cyan-300) {
      background-image: none !important;
      color: #ff3150 !important;
      -webkit-text-fill-color: #ff3150 !important;
    }

    :global(html.abf2-theme .text-cyan-50),
    :global(html.abf2-theme .text-cyan-100),
    :global(html.abf2-theme .text-cyan-200),
    :global(html.abf2-theme .text-cyan-300),
    :global(html.abf2-theme .text-cyan-400),
    :global(html.abf2-theme .text-cyan-500),
    :global(html.abf2-theme .text-cyan-600),
    :global(html.abf2-theme .text-sky-50),
    :global(html.abf2-theme .text-sky-100),
    :global(html.abf2-theme .text-sky-200),
    :global(html.abf2-theme .text-sky-300),
    :global(html.abf2-theme .text-sky-400),
    :global(html.abf2-theme .text-sky-500),
    :global(html.abf2-theme .text-sky-600),
    :global(html.abf2-theme .text-blue-300),
    :global(html.abf2-theme .text-blue-400),
    :global(html.abf2-theme .text-blue-500) {
      color: #ff3150 !important;
    }

