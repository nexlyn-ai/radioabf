function setABF2Header() {
  const headerLogo =
    document.querySelector(
      "#abfBrandLogo"
    );

  const playerLogo =
    document.querySelector(
      "#playerFallbackLogo"
    );

  const fsLogo =
    document.querySelector(
      "#fsFallbackLogo"
    );

  if (headerLogo) {
    headerLogo.setAttribute(
      "src",
      "/logo-abf2.png"
    );

    headerLogo.setAttribute(
      "alt",
      "ABF 2"
    );

    /* Logo ABF 2 -> home ABF 2 */
    const headerLogoLink =
      headerLogo.closest("a");

    if (headerLogoLink) {
      headerLogoLink.setAttribute(
        "href",
        "/abf2"
      );
    }
  }

  if (playerLogo) {
    playerLogo.setAttribute(
      "src",
      "/logo-abf2.png"
    );

    playerLogo.setAttribute(
      "alt",
      "ABF 2"
    );
  }

  if (fsLogo) {
    fsLogo.setAttribute(
      "src",
      "/logo-abf2.png"
    );

    fsLogo.setAttribute(
      "alt",
      "ABF 2"
    );
  }

  replaceHeaderText(
    "RadioABF",
    "ABF 2"
  );

  replaceHeaderText(
    "The DJs' Frequency",
    "The Hits Frequency"
  );

  setABF2Menu();
  
  /* Fullscreen Player -> ABF 2 */
  const allTextElements =
    document.querySelectorAll(
      "div, span, p, strong"
    );

  allTextElements.forEach((el) => {
    if (el.children.length) {
      return;
    }

    const text =
      (el.textContent || "")
        .trim();

    if (text === "RadioABF — Player") {
      el.textContent =
        "ABF 2 — Player";
    }

    if (text === "The DJs' Frequency") {
      el.textContent =
        "The Hits Frequency";
    }
  });

  /* Footer ABF 2 */
  const footer =
    document.querySelector("footer");

  if (footer) {
    const walker =
      document.createTreeWalker(
        footer,
        NodeFilter.SHOW_TEXT
      );

    const nodes = [];

    while (walker.nextNode()) {
      nodes.push(
        walker.currentNode
      );
    }

    nodes.forEach((node) => {
      const text =
        node.nodeValue || "";

      node.nodeValue =
        text
          .replace(
            /Radio ABF/g,
            "ABF 2"
          )
          .replace(
            /The DJs' Frequency/g,
            "The Hits Frequency"
          );
    });
  }
}

